)\n        if row[\"status\"] == \"suspended\" and (\n            not started\n            or row[\"pendingDependencies\"] != 0\n            or not _exact(row[\"awaited\"], {\"promiseId\"})\n            or not _id(row[\"awaited\"][\"promiseId\"])\n            or row[\"completionJobId\"] is not None\n            or row[\"failure\"] is not None\n        ):\n            _fail(\"suspended module state\")\n        if row[\"status\"] == \"failed-await\" and (\n            not started\n            or row[\"pendingDependencies\"] != 0\n            or row[\"awaited\"] is not None\n            or not _exact(row[\"failure\"], {\"moduleFile\", \"promiseId\", \"jobId\"})\n            or row[\"failure\"][\"moduleFile\"] != module[\"file\"]\n            or not _id(row[\"failure\"][\"promiseId\"])\n            or not _id(row[\"failure\"][\"jobId\"])\n            or row[\"completionJobId\"] is not None\n        ):\n            _fail(\"failed await state\")\n        if row[\"status\"] == \"fulfilled\" and (\n            not started\n            or row[\"pendingDependencies\"] != 0\n            or row[\"awaited\"] is not None\n            or not _id(row[\"completionJobId\"])\n            or row[\"failure\"] is not None\n        ):\n            _fail(\"fulfilled module state\")\n        if row[\"status\"] == \"rejected\" and (\n            row[\"awaited\"] is not None\n            or not _exact(row[\"failure\"], {\"moduleFile\", \"promiseId\", \"jobId\"})\n            or row[\"failure\"][\"moduleFile\"] not in {item[\"file\"] for item in plan[\"modules\"]}\n            or not _id(row[\"failure\"][\"promiseId\"])\n            or not _id(row[\"failure\"][\"jobId\"])\n            or not _id(row[\"completionJobId\"])\n            or row[\"completionJobId\"] != row[\"failure\"][\"jobId\"]\n            or (\n                started\n                and (\n                    row[\"failure\"][\"moduleFile\"] != module[\"file\"]\n                    or row[\"pendingDependencies\"] != 0\n                )\n            )\n        ):\n            _fail(\"rejected module state\")\n    for module in plan[\"modules\"]:\n        row = state[\"modules\"][module[\"file\"]]\n        for file in module[\"dependencies\"]:\n            dependency = state[\"modules\"][file]\n            completed = file in row[\"completedDependencies\"]\n            if dependency[\"status\"] == \"fulfilled\" and not completed:\n                _fail(\"missing completed dependency edge\")\n            if (\n                completed\n                and dependency[\"status\"] != \"fulfilled\"\n                and not (\n                    row[\"status\"] == \"rejected\"\n                    and dependency[\"status\"] == \"rejected\"\n                    and row[\"failure\"] == dependency[\"failure\"]\n                )\n            ):\n                _fail(\"completed dependency has no settled authority\")\n        if (\n            row[\"status\"] == \"rejected\"\n            and row[\"startOrder\"] is None\n            and not any(\n                state[\"modules\"][file][\"status\"] == \"rejected\"\n                and row[\"failure\"] == state[\"modules\"][file][\"failure\"]\n                for file in row[\"completedDependencies\"]\n            )\n        ):\n            _fail(\"propagated failure has no rejected dependency\")\n    if len(set(orders)) != len(orders) or len(orders) != state[\"nextStartOrder\"]:\n        _fail(\"noncanonical start order\")\n\n\ndef _settled_job(facts, action, status):\n    promise = facts.get(\"promises\", {}).get(action[\"promiseId\"])\n    job = facts.get(\"jobs\", {}).get(action[\"jobId\"])\n    if (\n        not isinstance(promise, Mapping)\n        or promise.get(\"id\") != action[\"promiseId\"]\n        or promise.get(\"status\") != status\n        or not isinstance(job, Mapping)\n        or job.get(\"id\") != action[\"jobId\"]\n        or job.get(\"promiseId\") != action[\"promiseId\"]\n        or job.get(\"frameId\") != action[\"frameId\"]\n        or job.get(\"status\") != status\n        or (\n            action[\"type\"] == \"module.resume\"\n            and (job.get(\"kind\") != \"promise-reaction\" or job.get(\"moduleFile\") != action[\"file\"])\n        )\n    ):\n        _fail(\"resume is not bound to the existing promise job\")\n    if (\n        \"value\" not in promise\n        or \"value\" not in job\n        or _canonical(promise[\"value\"]) != _canonical(job[\"value\"])\n    ):\n        _fail(\"promise/job outcome mismatch\")\n    return promise, job\n\n\ndef apply_module_scheduler_action_v8(plan, state, action, facts=None):\n    \"\"\"Return a new state after binding one action to current runtime facts.\"\"\"\n    verify_module_scheduler_plan_v8(plan)\n    facts = facts or {}\n    if (\n        not isinstance(state, Mapping)\n        or state.get(\"schema\") != STATE_SCHEMA\n        or state.get(\"planDigest\") != plan[\"digest\"]\n        or not isinstance(action, Mapping)\n    ):\n        _fail(\"state/action envelope\")\n    _verify_state(plan, state)\n    next_state = copy.deepcopy(state)\n    row = next_state[\"modules\"].get(action.get(\"file\"))\n    source = next((item for item in plan[\"modules\"] if item[\"file\"] == action.get(\"file\")), None)\n    if row is None or source is None:\n        _fail(\"unknown module\")\n    kind = action.get(\"type\")\n    if kind == \"module.start\":\n        if (\n            not _exact(action, {\"type\", \"file\", \"frameId\", \"executionPromiseId\"})\n            or row[\"status\"] != \"waiting\"\n            or row[\"pendingDependencies\"] != 0\n            or not _id(action[\"frameId\"])\n            or not _id(action[\"executionPromiseId\"])\n        ):\n            _fail(\"module start\")\n        if any(\n            next_state[\"modules\"][file][\"status\"] != \"fulfilled\" for file in source[\"dependencies\"]\n        ):\n            _fail(\"dependencies have not completed\")\n        frame = facts.get(\"frames\", {}).get(action[\"frameId\"])\n        promise = facts.get(\"promises\", {}).get(action[\"executionPromiseId\"])\n        if (\n            not isinstance(frame, Mapping)\n            or frame.get(\"id\") != action[\"frameId\"]\n            or frame.get(\"moduleFile\") != action[\"file\"]\n            or frame.get(\"executionPromiseId\") != action[\"executionPromiseId\"]\n            or any(\n                item[\"frameId\"] == action[\"frameId\"]\n                or item[\"executionPromiseId\"] == action[\"executionPromiseId\"]\n                for item in next_state[\"modules\"].values()\n            )\n            or not isinstance(promise, Mapping)\n            or promise.get(\"id\") != action[\"executionPromiseId\"]\n            or promise.get(\"status\") != \"pending\"\n        ):\n            _fail(\"module execution frame/promise identity\")\n        row.update(\n            status=\"running\",\n            frameId=action[\"frameId\"],\n            executionPromiseId=action[\"executionPromiseId\"],\n            startOrder=next_state[\"nextStartOrder\"],\n            completedDependencies=list(source[\"dependencies\"]),\n        )\n        next_state[\"nextStartOrder\"] += 1\n    elif kind == \"module.await\":\n        if (\n            not _exact(action, {\"type\", \"file\", \"frameId\", \"promiseId\"})\n            or row[\"status\"] != \"running\"\n            or row[\"frameId\"] != action[\"frameId\"]\n            or not source[\"hasTLA\"]\n            or row[\"awaited\"] is not None\n            or not _id(action[\"promiseId\"])\n        ):\n            _fail(\"module await\")\n        frame = facts.get(\"frames\", {}).get(action[\"frameId\"])\n        if (\n            not isinstance(frame, Mapping)\n            or frame.get(\"id\") != action[\"frameId\"]\n            or frame.get(\"moduleFile\") != action[\"file\"]\n            or frame.get(\"executionPromiseId\") != row[\"executionPromiseId\"]\n            or frame.get(\"awaitedPromiseId\") != action[\"promiseId\"]\n        ):\n            _fail(\"module await frame identity\")\n        promise = facts.get(\"promises\", {}).get(action[\"promiseId\"])\n        if (\n            not isinstance(promise, Mapping)\n            or promise.get(\"id\") != action[\"promiseId\"]\n            or promise.get(\"status\") != \"pending\"\n        ):\n            _fail(\"expected existing pending promise\")\n        row[\"awaited\"] = {\"promiseId\": action[\"promiseId\"]}\n        row[\"status\"] = \"suspended\"\n    elif kind == \"module.resume\":\n        if (\n            not _exact(action, {\"type\", \"file\", \"frameId\", \"promiseId\", \"jobId\"})\n            or row[\"status\"] != \"suspended\"\n            or row[\"frameId\"] != action[\"frameId\"]\n            or not isinstance(row[\"awaited\"], Mapping)\n            or row[\"awaited\"].get(\"promiseId\") != action[\"promiseId\"]\n            or not _id(action[\"jobId\"])\n        ):\n            _fail(\"module resume\")\n        frame = facts.get(\"frames\", {}).get(action[\"frameId\"])\n        if (\n            not isinstance(frame, Mapping)\n            or frame.get(\"id\") != action[\"frameId\"]\n            or frame.get(\"moduleFile\") != action[\"file\"]\n            or frame.get(\"executionPromiseId\") != row[\"executionPromiseId\"]\n            or frame.get(\"awaitedPromiseId\") != action[\"promiseId\"]\n        ):\n            _fail(\"resume frame identity\")\n        promise = facts.get(\"promises\", {}).get(action[\"promiseId\"])\n        if not isinstance(promise, Mapping) or promise.get(\"status\") not in {\n            \"fulfilled\",\n            \"rejected\",\n        }:\n            _fail(\"awaited promise is unsettled\")\n        promise, job = _settled_job(facts, action, promise[\"status\"])\n        if promise[\"status\"] == \"rejected\":\n            row[\"status\"] = \"failed-await\"\n            row[\"failure\"] = {\n                \"moduleFile\": action[\"file\"],\n                \"promiseId\": promise[\"id\"],\n                \"jobId\": job[\"id\"],\n            }\n        else:\n            if (\n                \"value\" not in promise\n                or \"value\" not in job\n                or _canonical(promise[\"value\"]) != _canonical(job[\"value\"])\n            ):\n                _fail(\"promise/job outcome mismatch\")\n            row[\"status\"] = \"running\"\n        row[\"awaited\"] = None\n    elif kind in {\"module.complete\", \"module.reject\"}:\n        if (\n            not _exact(action, {\"type\", \"file\", \"frameId\", \"promiseId\", \"jobId\"})\n            or row[\"status\"] not in {\"running\", \"suspended\", \"failed-await\"}\n            or row[\"frameId\"] != action[\"frameId\"]\n            or row[\"executionPromiseId\"] != action[\"promiseId\"]\n            or not _id(action[\"jobId\"])\n        ):\n            _fail(\"module settlement\")\n        if row[\"status\"] == \"suspended\":\n            _fail(\"cannot settle with unresolved await\")\n        rejecting = kind == \"module.reject\"\n        if row[\"status\"] == \"failed-await\" and not rejecting:\n            _fail(\"failed await cannot complete successfully\")\n        promise, job = _settled_job(facts, action, \"rejected\" if rejecting else \"fulfilled\")\n        row[\"status\"] = \"rejected\" if rejecting else \"fulfilled\"\n        row[\"awaited\"] = None\n        row[\"completionJobId\"] = job[\"id\"]\n        expected_kind = \"module-evaluation-failure\" if rejecting else \"module-execution-settle\"\n        if (\n            job.get(\"kind\") != expected_kind\n            or job.get(\"moduleFile\") != action[\"file\"]\n            or \"value\" not in promise\n            or \"value\" not in job\n            or _canonical(promise[\"value\"]) != _canonical(job[\"value\"])\n        ):\n            _fail(\"module execution settlement authority\")\n        row[\"failure\"] = (\n            {\"moduleFile\": action[\"file\"], \"promiseId\": promise[\"id\"], \"jobId\": job[\"id\"]}\n            if rejecting\n            else None\n        )\n    elif kind == \"module.propagateFailure\":\n        if (\n            not _exact(action, {\"type\", \"file\", \"dependencyFile\", \"promiseId\", \"jobId\"})\n            or row[\"status\"] != \"waiting\"\n            or action[\"dependencyFile\"] not in source[\"dependencies\"]\n            or action[\"dependencyFile\"] in row[\"completedDependencies\"]\n            or next_state[\"modules\"][action[\"dependencyFile\"]][\"status\"] != \"rejected\"\n            or next_state[\"modules\"][action[\"dependencyFile\"]][\"failure\"][\"promiseId\"]\n            != action[\"promiseId\"]\n            or next_state[\"modules\"][action[\"dependencyFile\"]][\"failure\"][\"jobId\"]\n            != action[\"jobId\"]\n            or not _id(action[\"promiseId\"])\n            or not _id(action[\"jobId\"])\n        ):\n            _fail(\"dependency failure propagation\")\n        promise = facts.get(\"promises\", {}).get(action[\"promiseId\"])\n        job = facts.get(\"jobs\", {}).get(action[\"jobId\"])\n        if (\n            not isinstance(promise, Mapping)\n            or promise.get(\"id\") != action[\"promiseId\"]\n            or promise.get(\"status\") != \"rejected\"\n            or not isinstance(job, Mapping)\n            or job.get(\"id\") != action[\"jobId\"]\n            or job.get(\"promiseId\") != action[\"promiseId\"]\n            or job.get(\"status\") != \"rejected\"\n            or job.get(\"kind\") != \"module-evaluation-failure\"\n            or job.get(\"moduleFile\")\n            != next_state[\"modules\"][action[\"dependencyFile\"]][\"failure\"][\"moduleFile\"]\n            or \"value\" not in promise\n            or \"value\" not in job\n            or _canonical(promise[\"value\"]) != _canonical(job[\"value\"])\n        ):\n            _fail(\"dependency propagation job identity\")\n        row[\"status\"] = \"rejected\"\n        row[\"failure\"] = {\n            \"moduleFile\": next_state[\"modules\"][action[\"dependencyFile\"]][\"failure\"][\"moduleFile\"],\n            \"promiseId\": promise[\"id\"],\n            \"jobId\": job[\"id\"],\n        }\n        row[\"completionJobId\"] = job[\"id\"]\n        row[\"completedDependencies\"].append(action[\"dependencyFile\"])\n        row[\"pendingDependencies\"] -= 1\n    else:\n        _fail(\"unknown action type\")\n    if kind == \"module.complete\":\n        for parent in plan[\"modules\"]:\n            parent_state = next_state[\"modules\"][parent[\"file\"]]\n            if (\n                action[\"file\"] in parent[\"dependencies\"]\n                and action[\"file\"] not in parent_state[\"completedDependencies\"]\n            ):\n                parent_state[\"completedDependencies\"].append(action[\"file\"])\n                parent_state[\"pendingDependencies\"] -= 1\n    _verify_state(plan, next_state)\n    return next_state\n"}
2026-11-22T09:00:45.6398484Z FORMATTED_SOURCE_JSON {"path": "tests/test_module_scheduler_state_v8.py", "content": "import copy\n\nimport pytest\n\nfrom megatoken.data.module_scheduler_state_v8 import (\n    apply_module_scheduler_action_v8,\n    build_module_scheduler_plan_v8,\n    create_module_scheduler_state_v8,\n)\n\nMETA = {\n    \"profile\": \"evaluated-module/1\",\n    \"evaluationStrategy\": \"async-dependency-scheduler\",\n    \"entryModule\": \"main.js\",\n    \"modules\": [\n        {\"file\": \"shared.js\", \"source\": \"export const x=1;\"},\n        {\"file\": \"left.js\", \"source\": \"import {x} from './shared.js'; await 0;\"},\n        {\"file\": \"right.js\", \"source\": \"import {x} from './shared.js'; await 0;\"},\n        {\"file\": \"main.js\", \"source\": \"import './left.js'; import './right.js';\"},\n    ],\n    \"asyncDependencies\": [\n        {\"file\": \"shared.js\", \"index\": 0, \"hasTLA\": False, \"dependencies\": []},\n        {\"file\": \"left.js\", \"index\": 1, \"hasTLA\": True, \"dependencies\": [0]},\n        {\"file\": \"right.js\", \"index\": 2, \"hasTLA\": True, \"dependencies\": [0]},\n        {\"file\": \"main.js\", \"index\": 3, \"hasTLA\": False, \"dependencies\": [1, 2]},\n    ],\n}\n\n\ndef _facts(file, frame, execution):\n    return {\n        \"frames\": {frame: {\"id\": frame, \"moduleFile\": file, \"executionPromiseId\": execution}},\n        \"promises\": {execution: {\"id\": execution, \"status\": \"pending\"}},\n        \"jobs\": {},\n    }\n\n\ndef _await_facts(file, frame, execution, promise, status=\"pending\", job=None):\n    return {\n        \"frames\": {\n            frame: {\n                \"id\": frame,\n                \"moduleFile\": file,\n                \"executionPromiseId\": execution,\n                \"awaitedPromiseId\": promise,\n            }\n        },\n        \"promises\": {\n            promise: {\n                \"id\": promise,\n                \"status\": status,\n                **({\"value\": None} if status != \"pending\" else {}),\n            }\n        },\n        \"jobs\": (\n            {\n                job: {\n                    \"id\": job,\n                    \"promiseId\": promise,\n                    \"frameId\": frame,\n                    \"status\": status,\n                    \"kind\": \"promise-reaction\",\n                    \"moduleFile\": file,\n                    \"value\": None,\n                }\n            }\n            if job\n            else {}\n        ),\n    }\n\n\ndef _complete(plan, state, file, n):\n    frame, promise, job = f\"f{n}\", f\"p{n}\", f\"j{n}\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.start\", \"file\": file, \"frameId\": frame, \"executionPromiseId\": promise},\n        _facts(file, frame, promise),\n    )\n    return apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.complete\",\n            \"file\": file,\n            \"frameId\": frame,\n            \"promiseId\": promise,\n            \"jobId\": job,\n        },\n        {\n            \"frames\": {},\n            \"promises\": {promise: {\"id\": promise, \"status\": \"fulfilled\", \"value\": None}},\n            \"jobs\": {\n                job: {\n                    \"id\": job,\n                    \"promiseId\": promise,\n                    \"frameId\": frame,\n                    \"status\": \"fulfilled\",\n                    \"kind\": \"module-execution-settle\",\n                    \"moduleFile\": file,\n                    \"value\": None,\n                }\n            },\n        },\n    )\n\n\ndef test_dag_start_order_is_derived_and_shared_dependency_completes_once():\n    plan = build_module_scheduler_plan_v8(META)\n    state = create_module_scheduler_state_v8(plan)\n    state = _complete(plan, state, \"shared.js\", 0)\n    assert state[\"nextStartOrder\"] == 1\n    assert state[\"modules\"][\"shared.js\"][\"status\"] == \"fulfilled\"\n    assert state[\"modules\"][\"left.js\"][\"status\"] == \"waiting\"\n    assert state[\"modules\"][\"right.js\"][\"status\"] == \"waiting\"\n\n\ndef test_resume_requires_same_existing_pending_promise_and_reaction_job():\n    plan = build_module_scheduler_plan_v8(META)\n    state = _complete(plan, create_module_scheduler_state_v8(plan), \"shared.js\", 0)\n    frame, execution, awaited = \"f1\", \"exec1\", \"await1\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.start\",\n            \"file\": \"left.js\",\n            \"frameId\": frame,\n            \"executionPromiseId\": execution,\n        },\n        _facts(\"left.js\", frame, execution),\n    )\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.await\", \"file\": \"left.js\", \"frameId\": frame, \"promiseId\": awaited},\n        _await_facts(\"left.js\", frame, execution, awaited),\n    )\n    with pytest.raises(ValueError, match=\"existing promise job\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            state,\n            {\n                \"type\": \"module.resume\",\n                \"file\": \"left.js\",\n                \"frameId\": frame,\n                \"promiseId\": awaited,\n                \"jobId\": \"forged\",\n            },\n            _await_facts(\"left.js\", frame, execution, awaited, \"fulfilled\", None),\n        )\n    assert state[\"modules\"][\"left.js\"][\"status\"] == \"suspended\"\n\n\ndef test_rejected_dependency_propagates_without_settling_independent_sibling():\n    plan = build_module_scheduler_plan_v8(META)\n    state = _complete(plan, create_module_scheduler_state_v8(plan), \"shared.js\", 0)\n\n    lf, le, la = \"left-frame\", \"left-exec\", \"left-await\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.start\", \"file\": \"left.js\", \"frameId\": lf, \"executionPromiseId\": le},\n        _facts(\"left.js\", lf, le),\n    )\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.await\", \"file\": \"left.js\", \"frameId\": lf, \"promiseId\": la},\n        _await_facts(\"left.js\", lf, le, la),\n    )\n    rf, re, ra = \"right-frame\", \"right-exec\", \"right-await\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.start\", \"file\": \"right.js\", \"frameId\": rf, \"executionPromiseId\": re},\n        _facts(\"right.js\", rf, re),\n    )\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\"type\": \"module.await\", \"file\": \"right.js\", \"frameId\": rf, \"promiseId\": ra},\n        _await_facts(\"right.js\", rf, re, ra),\n    )\n\n    reject_job = \"left-reaction\"\n    mismatch = _await_facts(\"left.js\", lf, le, la, \"rejected\", reject_job)\n    mismatch[\"jobs\"][reject_job][\"value\"] = \"wrong-reason\"\n    with pytest.raises(ValueError, match=\"outcome mismatch\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            state,\n            {\n                \"type\": \"module.resume\",\n                \"file\": \"left.js\",\n                \"frameId\": lf,\n                \"promiseId\": la,\n                \"jobId\": reject_job,\n            },\n            mismatch,\n        )\n    assert state[\"modules\"][\"left.js\"][\"status\"] == \"suspended\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.resume\",\n            \"file\": \"left.js\",\n            \"frameId\": lf,\n            \"promiseId\": la,\n            \"jobId\": reject_job,\n        },\n        _await_facts(\"left.js\", lf, le, la, \"rejected\", reject_job),\n    )\n    exec_job = \"left-exec-reject\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.reject\",\n            \"file\": \"left.js\",\n            \"frameId\": lf,\n            \"promiseId\": le,\n            \"jobId\": exec_job,\n        },\n        {\n            \"promises\": {le: {\"id\": le, \"status\": \"rejected\", \"value\": None}},\n            \"jobs\": {\n                exec_job: {\n                    \"id\": exec_job,\n                    \"promiseId\": le,\n                    \"frameId\": lf,\n                    \"status\": \"rejected\",\n                    \"kind\": \"module-evaluation-failure\",\n                    \"moduleFile\": \"left.js\",\n                    \"value\": None,\n                }\n            },\n        },\n    )\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.propagateFailure\",\n            \"file\": \"main.js\",\n            \"dependencyFile\": \"left.js\",\n            \"promiseId\": le,\n            \"jobId\": exec_job,\n        },\n        {\n            \"promises\": {le: {\"id\": le, \"status\": \"rejected\", \"value\": None}},\n            \"jobs\": {\n                exec_job: {\n                    \"id\": exec_job,\n                    \"promiseId\": le,\n                    \"frameId\": lf,\n                    \"status\": \"rejected\",\n                    \"kind\": \"module-evaluation-failure\",\n                    \"moduleFile\": \"left.js\",\n                    \"value\": None,\n                }\n            },\n        },\n    )\n    assert state[\"modules\"][\"main.js\"][\"status\"] == \"rejected\"\n    assert state[\"modules\"][\"right.js\"][\"status\"] == \"suspended\"\n\n    right_job = \"right-reaction\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.resume\",\n            \"file\": \"right.js\",\n            \"frameId\": rf,\n            \"promiseId\": ra,\n            \"jobId\": right_job,\n        },\n        _await_facts(\"right.js\", rf, re, ra, \"fulfilled\", right_job),\n    )\n    right_done = \"right-complete\"\n    state = apply_module_scheduler_action_v8(\n        plan,\n        state,\n        {\n            \"type\": \"module.complete\",\n            \"file\": \"right.js\",\n            \"frameId\": rf,\n            \"promiseId\": re,\n            \"jobId\": right_done,\n        },\n        {\n            \"promises\": {re: {\"id\": re, \"status\": \"fulfilled\", \"value\": None}},\n            \"jobs\": {\n                right_done: {\n                    \"id\": right_done,\n                    \"promiseId\": re,\n                    \"frameId\": rf,\n                    \"status\": \"fulfilled\",\n                    \"kind\": \"module-execution-settle\",\n                    \"moduleFile\": \"right.js\",\n                    \"value\": None,\n                }\n            },\n        },\n    )\n    assert state[\"modules\"][\"right.js\"][\"status\"] == \"fulfilled\"\n    assert state[\"modules\"][\"main.js\"][\"status\"] == \"rejected\"\n\n\ndef test_plan_rejects_cycle_and_tampered_digest():\n    cyclic = {**META, \"asyncDependencies\": [dict(row) for row in META[\"asyncDependencies\"]]}\n    cyclic[\"asyncDependencies\"][0][\"dependencies\"] = [1]\n    with pytest.raises(ValueError, match=\"cyclic\"):\n        build_module_scheduler_plan_v8(cyclic)\n    plan = build_module_scheduler_plan_v8(META)\n    plan[\"modules\"][0][\"hasTLA\"] = True\n    from megatoken.data.module_scheduler_state_v8 import verify_module_scheduler_plan_v8\n\n    with pytest.raises(ValueError, match=\"digest\"):\n        verify_module_scheduler_plan_v8(plan)\n\n\ndef test_early_and_duplicate_completion_are_refused_without_mutation():\n    plan = build_module_scheduler_plan_v8(META)\n    initial = create_module_scheduler_state_v8(plan)\n    frame, execution, job = \"shared-frame\", \"shared-exec\", \"shared-job\"\n    pending = _facts(\"shared.js\", frame, execution)\n    with pytest.raises(ValueError, match=\"module settlement\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            initial,\n            {\n                \"type\": \"module.complete\",\n                \"file\": \"shared.js\",\n                \"frameId\": frame,\n                \"promiseId\": execution,\n                \"jobId\": job,\n            },\n            pending,\n        )\n    assert initial[\"modules\"][\"shared.js\"][\"status\"] == \"waiting\"\n    malformed = copy.deepcopy(initial)\n    malformed[\"nextStartOrder\"] = 1\n    malformed[\"modules\"][\"left.js\"].update(\n        status=\"running\", startOrder=0, frameId=\"forged-frame\", executionPromiseId=\"forged-exec\"\n    )\n    with pytest.raises(ValueError, match=\"module state\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            malformed,\n            {\n                \"type\": \"module.start\",\n                \"file\": \"shared.js\",\n                \"frameId\": frame,\n                \"executionPromiseId\": execution,\n            },\n            pending,\n        )\n    assert initial[\"modules\"][\"left.js\"][\"status\"] == \"waiting\"\n    completed = _complete(plan, initial, \"shared.js\", 0)\n    terminal = copy.deepcopy(completed)\n    terminal[\"modules\"][\"shared.js\"][\"awaited\"] = {\"promiseId\": \"forged-await\"}\n    with pytest.raises(ValueError, match=\"module state\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            terminal,\n            {\n                \"type\": \"module.start\",\n                \"file\": \"left.js\",\n                \"frameId\": frame,\n                \"executionPromiseId\": execution,\n            },\n            pending,\n        )\n    with pytest.raises(ValueError, match=\"module start\"):\n        apply_module_scheduler_action_v8(\n            plan,\n            completed,\n            {\n                \"type\": \"module.start\",\n                \