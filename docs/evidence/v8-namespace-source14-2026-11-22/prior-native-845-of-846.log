\"data\" or not receiver_own[\"writable\"]\n                ):\n                    success = False\n                else:\n                    current = receiver_own or {\n                        \"kind\": \"data\",\n                        \"writable\": True,\n                        \"enumerable\": True,\n                        \"configurable\": True,\n                    }\n                    success = _define_own_property(\n                        receiver_node, key, {**current, \"value\": copy.deepcopy(record[\"value\"])}\n                    )\n            if success != record[\"success\"]:\n                _fail(\"false property write\")\n        elif kind == \"property.delete\":\n            descriptor = _descriptor(node, key)\n            success = descriptor is None or descriptor[\"configurable\"]\n            if success:\n                _remove(node, key)\n            if success != record[\"success\"]:\n                _fail(\"false property delete\")\n        elif kind == \"property.keys\":\n            keys = [_public(item) for item in _ordered(node)]\n            if record[\"mode\"] in (\"strings\", \"enumerable-strings\"):\n                keys = [k for k in keys if k[0] == \"str\"]\n            if record[\"mode\"] == \"symbols\":\n                keys = [k for k in keys if k[0] == \"symbol\"]\n            if record[\"mode\"] == \"enumerable-strings\":\n                keys = [k for k in keys if _descriptor(node, _key(k))[\"enumerable\"]]\n            if keys != record[\"keys\"]:\n                _fail(\"false property key order\")\n            array_record = {\n                \"kind\": \"allocate\",\n                \"name\": record[\"name\"],\n                \"objectKind\": \"array\",\n                \"length\": len(keys),\n                \"properties\": [\n                    {\"key\": [\"str\", str(i)], \"value\": key} for i, key in enumerate(keys)\n                ],\n                \"code\": None,\n                \"captures\": [],\n                \"functionKind\": None,\n                \"lexicalReceiver\": None,\n            }\n            _apply(machine, array_record)\n        elif kind == \"property.preventExtensions\":\n            node[\"extensible\"] = False\n        elif kind == \"property.prototype\":\n            if isinstance(record[\"prototype\"], list):\n                _known(machine, record[\"prototype\"])\n            before = node.get(\"prototype\", \"ordinary\")\n            success = before == record[\"prototype\"] or node.get(\"extensible\", True)\n            if success and isinstance(record[\"prototype\"], list):\n                target = record[\"prototype\"][1]\n                seen = set()\n                while True:\n                    if target == record[\"object\"] or target in seen:\n                        success = False\n                        break\n                    seen.add(target)\n                    ancestor = _node(machine, target)\n                    parent = ancestor.get(\"prototype\", \"ordinary\")\n                    if not isinstance(parent, list) or parent[0] != \"ref\":\n                        break\n                    target = parent[1]\n            if success:\n                node[\"prototype\"] = copy.deepcopy(record[\"prototype\"])\n            if success != record[\"success\"]:\n                _fail(\"false prototype transition\")\n        elif kind in (\"property.get.call\", \"property.set.call\"):\n            _, descriptor = _lookup_descriptor(machine, record[\"object\"], key)\n            operation = \"get\" if kind.endswith(\"get.call\") else \"set\"\n            callee = (\n                descriptor.get(operation)\n                if descriptor and descriptor[\"kind\"] == \"accessor\"\n                else None\n            )\n            if not callee or callee[0] != \"ref\":\n                _fail(\"property accessor callable required\")\n            parent = machine[\"stack\"][-1]\n            call_record = {\n                \"kind\": \"call\",\n                \"child\": record[\"child\"],\n                \"callee\": callee,\n                \"receiver\": record[\"receiver\"],\n                \"arguments\": [] if operation == \"get\" else [record[\"value\"]],\n            }\n            _apply(machine, call_record)\n            p[\"pendingCalls\"].append(\n                {\n                    \"id\": record[\"id\"],\n                    \"operation\": operation,\n                    \"child\": record[\"child\"],\n                    \"parent\": parent,\n                    \"object\": record[\"object\"],\n                    \"key\": copy.deepcopy(record[\"key\"]),\n                    \"receiver\": copy.deepcopy(record[\"receiver\"]),\n                    \"callee\": copy.deepcopy(callee),\n                    \"value\": None if operation == \"get\" else copy.deepcopy(record[\"value\"]),\n                }\n            )\n        else:\n            _fail(\"unsupported transition\")\n\n\ndef apply_protocol_record(machine, record):\n    \"\"\"Apply one checked row transactionally to a native JSON-safe machine.\"\"\"\n    validate_protocol_record(record)\n    staged = copy.deepcopy(machine)\n    if \"protocol\" not in staged:\n        staged[\"protocol\"] = create_protocol_state()\n    if staged[\"protocol\"].get(\"schema\") != STATE_SCHEMA:\n        _fail(\"protocol state version\")\n    if staged[\"protocol\"][\"sequence\"] >= 32768:\n        _fail(\"protocol step budget\")\n    _apply(staged, record)\n    staged[\"protocol\"][\"sequence\"] += 1\n    machine.clear()\n    machine.update(staged)\n    return {\n        \"status\": \"committed\",\n        \"kind\": record[\"kind\"],\n        \"sequence\": machine[\"protocol\"][\"sequence\"],\n        \"completion\": copy.deepcopy(machine.get(\"completion\")),\n    }\n\n\ndef _internal_machine(initial):\n    machine = copy.deepcopy(initial)\n    machine[\"heap\"] = {}\n    for identity, node in initial[\"heap\"]:\n        n = copy.deepcopy(node)\n        n[\"properties\"] = {\n            _key(key) if isinstance(key, list) else key: value\n            for key, value in n.get(\"properties\", [])\n        }\n        if n.get(\"kind\") not in (\n            \"array-buffer\",\n            \"shared-int32-buffer\",\n            \"typed-array\",\n            \"shared-int32-view\",\n            \"data-view\",\n            \"shared-data-view\",\n            \"iterator\",\n        ):\n            if \"descriptors\" in n:\n                n[\"descriptors\"] = {\n                    _key(key) if isinstance(key, list) else key: value\n                    for key, value in n.get(\"descriptors\", [])\n                }\n            if \"keyOrder\" in n:\n                n[\"keyOrder\"] = [\n                    _key(key) if isinstance(key, list) else key for key in n.get(\"keyOrder\", [])\n                ]\n        if isinstance(n.get(\"privateElements\"), list):\n            n[\"privateElements\"] = {\n                key: copy.deepcopy(value) for key, value in n[\"privateElements\"]\n            }\n        machine[\"heap\"][identity] = n\n    for field in (\"locals\", \"captureAliases\", \"frameFunctions\"):\n        machine[field] = (\n            dict(initial[field])\n            if isinstance(initial[field], list)\n            else copy.deepcopy(initial[field])\n        )\n    return machine\n\n\ndef _external_machine(machine):\n    result = copy.deepcopy(machine)\n    result[\"heap\"] = []\n    for identity, node in machine[\"heap\"].items():\n        n = copy.deepcopy(node)\n        n[\"properties\"] = [\n            [key if isinstance(key, str) else [\"symbol\", key[1]], value]\n            for key, value in n.get(\"properties\", {}).items()\n        ]\n        if \"descriptors\" in n:\n            n[\"descriptors\"] = [\n                [key if isinstance(key, str) else [\"symbol\", key[1]], value]\n                for key, value in n[\"descriptors\"].items()\n            ]\n        if \"keyOrder\" in n:\n            n[\"keyOrder\"] = [\n                key if isinstance(key, str) else [\"symbol\", key[1]] for key in n.get(\"keyOrder\", [])\n            ]\n        if isinstance(n.get(\"privateElements\"), dict):\n            n[\"privateElements\"] = [\n                [key, copy.deepcopy(value)] for key, value in n[\"privateElements\"].items()\n            ]\n        result[\"heap\"].append([identity, n])\n    for field in (\"locals\", \"captureAliases\", \"frameFunctions\"):\n        result[field] = [[key, value] for key, value in machine[field].items()]\n    return result\n\n\ndef replay_protocol_case(case, *, namespace_plan=None):\n    if not isinstance(case, dict) or not isinstance(case.get(\"lines\"), list):\n        _fail(\"protocol case shape\")\n    state = copy.deepcopy(case[\"initialState\"])\n    for number, line in enumerate(case[\"lines\"]):\n        try:\n            decode_protocol_record(line)\n        except ProtocolV8Error as error:\n            raise ProtocolV8Error(f\"protocol line {number}: {error}\") from error\n        state = apply_protocol_to_shared_state(state, line, namespace_plan=namespace_plan)\n        if number + 1 in case.get(\"checkpoints\", []):\n            state = json.loads(json.dumps(state, separators=(\",\", \":\"), ensure_ascii=False))\n            machine = _internal_machine(state)\n            if machine[\"protocol\"][\"sequence\"] != number + 1:\n                _fail(\"checkpoint sequence\")\n            validate_protocol_state(\n                machine[\"protocol\"], machine[\"heap\"], _external_machine(machine)\n            )\n    return state\n\n\ndef validate_protocol_state(snapshot, heap_ids=(), shared_state=None):\n    base_fields = {\n        \"schema\",\n        \"symbols\",\n        \"pendingCalls\",\n        \"callFrames\",\n        \"sequence\",\n        \"numberConversions\",\n        \"primitiveConversions\",\n        \"proxyCalls\",\n        \"promiseExecutors\",\n    }\n    if type(snapshot) is dict and \"construction\" in snapshot:\n        _exact(snapshot, base_fields | {\"construction\"}, \"shared protocol state\")\n    else:\n        _exact(snapshot, base_fields, \"shared protocol state\")\n    heap_nodes = None\n    if (\n        isinstance(heap_ids, dict)\n        or isinstance(heap_ids, list)\n        and all(isinstance(row, list) and len(row) == 2 for row in heap_ids)\n    ):\n        heap_nodes = {}\n        for identity, node in heap_ids.items() if isinstance(heap_ids, dict) else heap_ids:\n            if identity in heap_nodes:\n                _fail(\"duplicate heap identity\")\n            converted = copy.deepcopy(node)\n            for field in (\"properties\", \"descriptors\"):\n                if isinstance(converted.get(field), list):\n                    converted[field] = {\n                        _key(key) if isinstance(key, list) else key: value\n                        for key, value in converted[field]\n                    }\n            if isinstance(converted.get(\"keyOrder\"), list):\n                converted[\"keyOrder\"] = [\n                    _key(key) if isinstance(key, list) else key for key in converted[\"keyOrder\"]\n                ]\n            if isinstance(converted.get(\"privateElements\"), list):\n                converted[\"privateElements\"] = {\n                    key: value for key, value in converted[\"privateElements\"]\n                }\n            heap_nodes[identity] = converted\n    if (\n        snapshot[\"schema\"] != STATE_SCHEMA\n        or type(snapshot[\"sequence\"]) is not int\n        or not 0 <= snapshot[\"sequence\"] <= 32768\n    ):\n        _fail(\"protocol state schema or sequence\")\n    if not isinstance(snapshot[\"symbols\"], list) or len(snapshot[\"symbols\"]) > 4096:\n        _fail(\"symbol table bound\")\n    identities = set()\n    registry = set()\n    for row in snapshot[\"symbols\"]:\n        if (\n            not isinstance(row, dict)\n            or not isinstance(row.get(\"id\"), str)\n            or row[\"id\"] in identities\n        ):\n            _fail(\"duplicate symbol identity\")\n        identities.add(row[\"id\"])\n        if row[\"kind\"] == \"well-known\":\n            _exact(row, {\"id\", \"kind\", \"name\"}, \"well-known symbol\")\n            if row[\"name\"] not in WELL_KNOWN or row[\"id\"] != \"well-known:\" + row[\"name\"]:\n                _fail(\"well-known symbol table\")\n        elif row[\"kind\"] == \"unique\":\n            _exact(row, {\"id\", \"kind\", \"description\"}, \"unique symbol\")\n            if not __import__(\"re\").fullmatch(r\"o[1-9][0-9]*\", row[\"id\"]):\n                _fail(\"unique symbol identity\")\n            validate_protocol_value(row[\"description\"])\n            if row[\"description\"][0] not in (\"str\", \"undefined\"):\n                _fail(\"symbol description\")\n        elif row[\"kind\"] == \"registry\":\n            _exact(row, {\"id\", \"kind\", \"description\", \"key\"}, \"registry symbol\")\n            if (\n                not __import__(\"re\").fullmatch(r\"o[1-9][0-9]*\", row[\"id\"])\n                or not isinstance(row[\"key\"], str)\n                or row[\"key\"] in registry\n                or row[\"description\"] != [\"str\", row[\"key\"]]\n            ):\n                _fail(\"registry symbol\")\n            registry.add(row[\"key\"])\n        else:\n            _fail(\"symbol kind\")\n        if row[\"id\"] in (heap_nodes if heap_nodes is not None else heap_ids):\n            _fail(\"symbol/heap identity collision\")\n    if not all(\n        any(\n            row[\"id\"] == \"well-known:\" + name and row[\"kind\"] == \"well-known\"\n            for row in snapshot[\"symbols\"]\n        )\n        for name in WELL_KNOWN\n    ):\n        _fail(\"well-known table incomplete\")\n    if (\n        not isinstance(snapshot[\"pendingCalls\"], list)\n        or len(snapshot[\"pendingCalls\"]) > 64\n        or not isinstance(snapshot[\"callFrames\"], list)\n        or len(snapshot[\"callFrames\"]) > 64\n    ):\n        _fail(\"pending calls/frame bound\")\n    pending_ids = set()\n    for pending in snapshot[\"pendingCalls\"]:\n        _exact(\n            pending,\n            {\"id\", \"operation\", \"child\", \"parent\", \"object\", \"key\", \"receiver\", \"callee\", \"value\"},\n            \"pending property call\",\n        )\n        if pending[\"id\"] in pending_ids or pending[\"operation\"] not in (\"get\", \"set\"):\n            _fail(\"pending call identity or kind\")\n        pending_ids.add(pending[\"id\"])\n        _identity(pending[\"child\"])\n        _identity(pending[\"parent\"])\n        _identity(pending[\"object\"])\n        validate_protocol_key(pending[\"key\"])\n        validate_protocol_value(pending[\"receiver\"])\n        validate_protocol_value(pending[\"callee\"])\n        if pending[\"callee\"][0] != \"ref\":\n            _fail(\"pending accessor closure\")\n        if pending[\"operation\"] == \"get\" and pending[\"value\"] is not None:\n            _fail(\"getter pending value\")\n        if pending[\"operation\"] == \"set\":\n            validate_protocol_value(pending[\"value\"])\n    for frame in snapshot[\"callFrames\"]:\n        _exact(\n            frame,\n            {\"child\", \"parent\", \"priorReceiver\", \"priorAliases\", \"arguments\"},\n            \"protocol call frame\",\n        )\n        _identity(frame[\"child\"])\n        _identity(frame[\"parent\"])\n        validate_protocol_value(frame[\"priorReceiver\"])\n        if not isinstance(frame[\"priorAliases\"], list) or not isinstance(frame[\"arguments\"], list):\n            _fail(\"call frame arrays\")\n        seen = set()\n        for pair in frame[\"priorAliases\"]:\n            if (\n                not isinstance(pair, list)\n                or len(pair) != 2\n                or any(not isinstance(x, str) for x in pair)\n                or pair[0] in seen\n            ):\n                _fail(\"call frame aliases\")\n            seen.add(pair[0])\n        for value in frame[\"arguments\"]:\n            validate_protocol_value(value)\n    if snapshot.get(\"construction\") is not None:\n        if heap_nodes is None:\n            _fail(\"construction validation requires full shared heap\")\n        construction_machine = (\n            _internal_machine(shared_state)\n            if shared_state is not None\n            else {\"heap\": heap_nodes, \"protocol\": snapshot}\n        )\n        validate_construction_record_state(snapshot[\"construction\"], construction_machine)\n    if snapshot[\"primitiveConversions\"] is not None:\n        if shared_state is None:\n            _fail(\"primitive conversion validation requires complete shared state\")\n        conversion_machine = _internal_machine(shared_state)\n        conversion_machine[\"protocol\"] = snapshot\n        validate_primitive_conversion_state(conversion_machine)\n    if shared_state is not None:\n        active_machine = _internal_machine(shared_state)\n        for binding, cell in active_machine.get(\"captureAliases\", {}).items():\n            if (\n                not isinstance(binding, str)\n                or not isinstance(cell, str)\n                or cell not in active_machine[\"locals\"]\n            ):\n                _fail(\"active closure capture is not initialized\")\n            _known(active_machine, active_machine[\"locals\"][cell])\n    if heap_nodes is not None:\n        known_machine = {\"heap\": heap_nodes, \"protocol\": snapshot}\n        for identity, node in heap_nodes.items():\n            if not isinstance(node, dict):\n                continue\n            if len(set(node.get(\"properties\", {})) | set(node.get(\"descriptors\", {}))) > 4096:\n                _fail(\"own property bound\")\n            for key, value in node.get(\"properties\", {}).items():\n                if isinstance(key, tuple):\n                    _symbol(known_machine, key[1])\n                _known(known_machine, value, identity)\n            for key, descriptor in node.get(\"descriptors\", {}).items():\n                if isinstance(key, tuple):\n                    _symbol(known_machine, key[1])\n                if descriptor.get(\"kind\") == \"data\":\n                    _exact(\n                        descriptor,\n                        {\"kind\", \"writable\", \"enumerable\", \"configurable\"},\n                        \"stored data descriptor\",\n                    )\n                    if key not in node.get(\"properties\", {}):\n                        _fail(\"data descriptor lacks stored value\")\n                    _validate_descriptor({**descriptor, \"value\": node[\"properties\"][key]})\n                else:\n                    _validate_descriptor(descriptor)\n                    for field in (\"get\", \"set\"):\n                        value = _known(known_machine, descriptor[field], identity)\n                        if (\n                            value[0] == \"ref\"\n                            and _node(known_machine, value[1])[\"kind\"] != \"closure\"\n                        ):\n                            _fail(\"property accessor must be callable\")\n            prototype = node.get(\"prototype\", \"ordinary\")\n            if isinstance(prototype, list):\n                _known(known_machine, prototype, identity)\n            if node.get(\"functionKind\") == \"arrow\":\n                _known(known_machine, node.get(\"lexicalReceiver\"), identity)\n        memory_machine = (\n            _internal_machine(shared_state) if shared_state is not None else {\"heap\": heap_nodes}\n        )\n        validate_memory_state(memory_machine)\n        validate_iterator_state(memory_machine)\n        validate_enumeration_state({**memory_machine, \"protocol\": snapshot})\n        from .promise_join_v8 import validate_state as validate_promise_join_state\n\n        validate_promise_join_state(memory_machine)\n        from .promise_executor_v8 import validate_state as validate_promise_executor_state\n\n        validate_promise_executor_state(memory_machine)\n        validate_number_state(memory_machine)\n        validate_generator_state(memory_machine)\n        validate_proxy_state(memory_machine)\n    return True\n\n\ndef _assert_no_generic_source_cell_write(machine, record, namespace_plan):\n    if namespace_plan is None or record[\"kind\"] not in {\"bind\", \"compute\", \"symbol.read\"}:\n        return\n    from .module_namespace_state_v8 import verify_experimental_module_namespace_plan\n\n    verify_experimental_module_namespace_plan(namespace_plan)\n    source_cells = {\n        cell[\"id\"]: cell\n        for cell in namespace_plan[\"cells\"]\n        if any(\n            export[\"cell\"] == cell[\"id\"]\n            for namespace in namespace_plan[\"namespaces\"]\n            for export in namespace[\"exports\"]\n        )\n    }\n    aliases = machine.get(\"captureAliases\", {})\n    protected = {\n        aliases.get(cell[\"loweredName\"], cell[\"loweredName\"]) for cell in source_cells.values()\n    }\n    protected.update(\n        aliases.get(namespace[\"namespaceName\"], namespace[\"namespaceName\"])\n        for namespace in namespace_plan[\"namespaces\"]\n    )\n    target = record.get(\"name\") if record[\"kind\"] == \"bind\" else record.get(\"bind\")\n    if target is not None and aliases.get(target, target) in protected:\n        _fail(\"namespace owner and source cells require their declared lifecycle records\")\n\n\ndef apply_protocol_to_shared_state(shared_state, line, *, namespace_plan=None):\n    \"\"\"Apply a protocol/1 line to the v8 shared heap/locals/call stack.\"\"\"\n    record = decode_protocol_record(line)\n    machine = _internal_machine(shared_state)\n    if machine.get(\"protocol\") is None:\n        machine[\"protocol\"] = create_protocol_state()\n    _assert_no_generic_source_cell_write(machine, record, namespace_plan)\n    external = _external_machine(machine)\n    validate_protocol_state(external[\"protocol\"], external[\"heap\"], external)\n\n    if record[\"kind\"] not in NAMESPACE_RECORD_KINDS:\n        before = copy.deepcopy(external)\n        apply_protocol_record(machine, record)\n        external_updated = _external_machine(machine)\n        if namespace_plan is not None:\n            from .module_namespace_machine_v8 import (\n                assert_experimental_module_namespace_state_unchanged,\n            )\n\n            assert_experimental_module_namespace_state_unchanged(\n                before, external_updated, namespace_plan\n            )\n        return external_updated\n\n    if namespace_plan is None:\n        _fail(\"source-derived namespace plan is required\")\n    p = machine[\"protocol\"]\n    if not machine.get(\"stack\") or machine.get(\"completion\") is not None or p[\"pendingCalls\"]:\n        _fail(\"active invocation with no pending property child required for namespace transition\")\n    if p[\"sequence\"] >= 32768:\n        _fail(\"protocol step budget\")\n    # Preserve the exact global ordering guards used by ordinary protocol records.\n    assert_number_next(machine, record)\n    assert_primitive_conversion_next(machine, record)\n    assert_generator_next(machine, record)\n    assert_proxy_next(machine, record)\n    assert_promise_executor_next(machine, record)\n    assert_promise_join_next(machine, record)\n    if p.get(\"construction\") is not None:\n        assert_construction_next(machine, record)\n\n    from .module_namespace_machine_v8 import (\n        apply_experimental_module_namespace_shared_transition,\n        validate_experimental_module_namespace_shared_state,\n    )\n\n    staged = apply_experimental_module_namespace_shared_transition(\n        _external_machine(machine), namespace_plan, record\n    )\n    updated = _internal_machine(staged)\n    updated[\"protocol\"][\"sequence\"] = p[\"sequence\"] + 1\n    external_updated = _external_machine(updated)\n    validate_protocol_state(updated[\"protocol\"], updated[\"heap\"], external_updated)\n    validate_experimental_module_namespace_shared_state(external_updated, namespace_plan)\n    return external_updated\n\n\ndef validate_completion_detail(shared_state, kind, fields):\n    \"\"\"Validate the existing transfer's bounded, non-executable handler scopes.\"\"\"\n    scope = fields.get(\"handler\")\n    if (\n        kind != \"transfer\"\n        or not isinstance(scope, dict)\n        or scope.get(\"schema\") != \"semantic-handler-scopes/1\"\n    ):\n        return False\n    if fields.get(\"kind\") != \"cleanup\" or fields.get(\"value\") != [\"undefined\"]:\n        _fail(\"ordinary handler-scope transfer kind/value\")\n    _exact(scope, {\"schema\", \"frames\"}, \"ordinary handler scopes\")\n    if type(scope[\"frames\"]) is not list or len(scope[\"frames\"]) > 64:\n        _fail(\"ordinary handler frame bound\")\n    machine = _internal_machine(shared_state)\n    previous = -1\n    identities = set()\n\n    def value(tag):\n        _known(machine, tag)\n        if tag[0] == \"symbol\":\n            _fail(\"Symbol cleanup needs protocol transfer\")\n\n    for frame in scope[\"frames\"]:\n        _exact(\n            frame,\n            {\"invocation\", \"handlers\"}\n            | ({\"targets\"} if type(frame) is dict and \"targets\" in frame else set()),\n            \"ordinary handler frame\",\n        )\n        if (\n            frame[\"invocation\"] not in machine[\"stack\"]\n            or frame[\"invocation\"] not in machine[\"frameFunctions\"]\n        ):\n            _fail(\"ordinary handler frame is not active\")\n        index = machine[\"stack\"].index(frame[\"invocation\"])\n        if index <= previous:\n            _fail(\"ordinary handler frame stack order\")\n        previous = index\n        targets = {}\n        if \"targets\" in frame:\n            if type(frame[\"targets\"]) is not list or not 0 < len(frame[\"targets\"]) <= 64:\n                _fail(\"ordinary loop target bound\")\n            for target in frame[\"targets\"]:\n                _exact(target, {\"id\", \"continue\"}, \"ordinary loop target\")\n                _identity(target[\"id\"])\n                if target[\"id\"] in identities or type(target[\"continue\"]) is not bool:\n                    _fail(\"ordinary loop target identity/capability\")\n                identities.add(target[\"id\"])\n                targets[target[\"id\"]] = target\n        if type(frame[\"handlers\"]) is not list or not 0 < len(frame[\"handlers\"]) <= 64:\n            _fail(\"ordinary handler bound\")\n        for handler in frame[\"handlers\"]:\n            _exact(\n                handler,\n                {\"id\", \"catch\", \"finally\", \"phase\", \"caught\", \"pending\"},\n                \"ordinary handler\",\n            )\n            _identity(handler[\"id\"])\n            if handler[\"id\"] in identities:\n                _fail(\"ordinary handler identity\")\n            identities.add(handler[\"id\"])\n            if (\n                type(handler[\"catch\"]) is not bool\n                or type(handler[\"finally\"]) is not bool\n                or not (handler[\"catch\"] or handler[\"finally\"])\n                or handler[\"phase\"] not in (\"try\", \"catch\", \"finally\")\n                or handler[\"phase\"] == \"catch\"\n                and not handler[\"catch\"]\n                or handler[\"phase\"] == \"finally\"\n                and not handler[\"finally\"]\n            ):\n                _fail(\"ordinary handler phase/capability\")\n            if handler[\"caught\"] is not None:\n                if handler[\"phase\"] != \"catch\":\n                    _fail(\"caught value outside catch\")\n                value(handler[\"caught\"])\n            if (handler[\"phase\"] == \"finally\") != (handler[\"pending\"] is not None):\n                _fail(\"ordinary cleanup pending completion\")\n            if handler[\"pending\"] is not None:\n                pending = handler[\"pending\"]\n                jump = type(pending) is dict and pending.get(\"kind\") in (\"break\", \"continue\")\n                _exact(\n                    pending,\n                    {\"kind\", \"value\"} | ({\"target\"} if jump else set()),\n                    \"ordinary pending completion\",\n                )\n                if pending[\"kind\"] not in (\"normal\", \"return\", \"throw\", \"break\", \"continue\"):\n                    _fail(\"ordinary completion kind\")\n                value(pending[\"value\"])\n                if pending[\"kind\"] in (\"normal\", \"break\", \"continue\") and pending[\"value\"] != [\n                    \"undefined\"\n                ]:\n                    _fail(\"normal or loop cleanup has no return value\")\n                if jump:\n                    _identity(pending[\"target\"])\n                    target = targets.get(pending[\"target\"])\n                    if not target or pending[\"kind\"] == \"continue\" and not target[\"continue\"]:\n                        _fail(\"ordinary completion target is absent or cannot continue\")\n    return True\n\n\ndef _assert_no_detailed_source_cell_write(machine, kind, fields, namespace_plan):\n    if namespace_plan is None or kind not in {\"bind\", \"compute\"}:\n        return\n    from .module_namespace_state_v8 import verify_experimental_module_namespace_plan\n\n    verify_experimental_module_namespace_plan(namespace_plan)\n    aliases = machine.get(\"captureAliases\", {})\n    protected = {\n        aliases.get(cell[\"loweredName\"], cell[\"loweredName\"])\n        for cell in namespace_plan[\"cells\"]\n        if any(\n            export[\"cell\"] == cell[\"id\"]\n            for namespace in namespace_plan[\"namespaces\"]\n            for export in namespace[\"exports\"]\n        )\n    }\n    protected.update(\n        aliases.get(namespace[\"namespaceName\"], namespace[\"namespaceName\"])\n        for namespace in namespace_plan[\"namespaces\"]\n    )\n    target = fields.get(\"name\") if kind == \"bind\" else fields.get(\"bind\")\n    if target is not None and aliases.get(target, target) in protected:\n        _fail(\"Detailed write to namespace owner/source cell bypasses lifecycle record\")\n\n\ndef assert_detailed_record_compatible(shared_state, kind, fields, *, namespace_plan=None):\n    \"\"\"Reject legacy detail that would bypass rich protocol property state.\"\"\"\n    validate_completion_detail(shared_state, kind, fields)\n    machine = _internal_machine(shared_state)\n    _assert_no_detailed_source_cell_write(machine, kind, fields, namespace_plan)\n    protocol = shared_state.get(\"protocol\")\n    if protocol is None:\n        return True\n    if protocol[\"pendingCalls\"] and protocol[\"pendingCalls\"][-1][\"child\"] not in machine[\"stack\"]:\n        _fail(\"pending property completion requires protocol finish\")\n    assert_construction_next(machine, {\"kind\": kind, **fields})\n    assert_number_next(machine, {\"kind\": kind, \"fields\": fields})\n    assert_primitive_conversion_next(machine, {\"kind\": kind, \"fields\": fields})\n    assert_generator_next(machine, {\"kind\": kind, **fields})\n    assert_proxy_next(machine, {\"kind\": kind, **fields})\n    assert_promise_executor_next(machine, {\"kind\": kind, **fields})\n    assert_promise_join_next(machine, {\"kind\": kind, **fields})\n\n    def rich(node):\n        descriptors = node.get(\"descriptors\", {})\n        nondefault = any(\n            metadata\n            != {\n                \"kind\": \"data\",\n                \"writable\": True,\n                \"enumerable\": not (node[\"kind\"] == \"array\" and key == \"length\"),\n                \"configurable\": not (node[\"kind\"] == \"array\" and key == \"length\"),\n            }\n            for key, metadata in descriptors.items()\n        )\n        return bool(\n            nondefault\n            or node.get(\"extensible\") is False\n            or node.get(\"prototype\") not in (None, \"ordinary\")\n            or any(isinstance(key, tuple) for key in node.get(\"properties\", {}))\n            or node.get(\"kind\") == \"generator\"\n            or node.get(\"kind\") == \"enumerator\"\n            or node.get(\"generatorFunction\") is True\n            or node.get(\"kind\") == \"proxy\"\n            or node.get(\"promiseResolver\")\n        )\n\n    def inspect(value):\n        if not isinstance(value, (dict, list)):\n            return\n        if isinstance(value, list):\n            if value and value[0] == \"symbol\":\n                _fail(\"Symbol data must use protocol records\")\n            for child in value:\n                inspect(child)\n        else:\n            if value.get(\"op\") == \"read\":\n                node = machine[\"heap\"].get(value.get(\"object\"))\n                if node and rich(node):\n                    _fail(\"Detailed read bypasses descriptor/prototype protocol\")\n            for child in value.values():\n                inspect(child)\n\n    inspect(fields)\n    if kind in (\"read\", \"write\"):\n        node = machine[\"heap\"].get(fields.get(\"object\"))\n        if node and (\n            rich(node) or kind == \"write\" and (\"descriptors\" in node or \"keyOrder\" in node)\n        ):\n            _fail(\"Detailed property transition bypasses rich protocol state\")\n    if kind in (\"call\", \"construct\"):\n        callee = fields.get(\"callee\")\n        identity = (\n            callee[1]\n            if isinstance(callee, list) and len(callee) == 2 and callee[0] == \"ref\"\n            else callee\n        )\n        target = machine[\"heap\"].get(identity)\n        if target and target.get(\"generatorFunction\") is True:\n            _fail(\"Detailed call bypasses generator creation/resume protocol\")\n        if kind == \"call\" and target:\n            assert_promise_executor_callable(machine, [\"ref\", identity])\n    if shared_state[\"protocol\"][\"pendingCalls\"] and kind == \"end\":\n        _fail(\"Unfinished accessor call\")\n    if kind in (\"return\", \"throw\") and machine[\"stack\"]:\n        child = fields.get(\"invocation\", machine[\"stack\"][-1])\n        if protocol[\"callFrames\"] and child != machine[\"stack\"][-1]:\n            _fail(\"Detailed completion must name the active invocation\")\n        if any(frame[\"child\"] == child for frame in protocol[\"callFrames\"]):\n            _fail(\"Protocol-owned invocation requires protocol completion\")\n    return True\n"}
2026-11-22T07:31:55.2662048Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/data/native_v8.py", "content": "\"\"\"Public-prefix checks for semantic execution/8.\n\nThis module intentionally distinguishes public replay engineering checks from\nsource-bound production admission. It never promotes a document whose selected\nshared continuation and private source correspondence were not independently\nreplayed by the full native controller.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport hashlib\nimport json\nfrom collections.abc import Mapping\n\nfrom megatoken.controls import (\n    canonical_semantic_observation,\n    semantic_execution_metadata_v8,\n    semantic_selection_instruction_v8,\n)\n\nfrom . import semantic_primitives as primitives\nfrom .algorithm_v8 import replay_algorithm_line\nfrom .detailed_v8 import encode_record, parse_record\nfrom .detailed_v8 import value as validate_value\nfrom .module_namespace_machine_v8 import (\n    assert_experimental_module_namespace_state_unchanged,\n    validate_experimental_module_namespace_shared_state,\n)\nfrom .module_namespace_state_v8 import verify_experimental_module_namespace_plan\nfrom .protocol_v8 import (\n    ProtocolV8Error,\n    _array_index,\n    _assert_fresh_heap_identity,\n    _external_machine,\n    _internal_machine,\n    apply_protocol_to_shared_state,\n    assert_detailed_record_compatible,\n    decode_protocol_record,\n    validate_completion_detail,\n    validate_protocol_state,\n)\nfrom .schema import (\n    Dependency,\n    Episode,\n    Lineage,\n    LogicalAction,\n    Meridian,\n    PhysicalRecord,\n    Supervision,\n    TrackEvent,\n    TrackSpec,\n    encode_episode,\n)\nfrom .semantic_contract_v8 import (\n    CONTRACT_DIGEST,\n    SemanticContractV8Error,\n    validate_public,\n)\nfrom .semantic_json import stable_algorithm_hash, stable_algorithm_json\nfrom .semantic_orchestration_training_v8 import (\n    ORCHESTRATION_RECORD_SCHEMA,\n    orchestration_selection_instruction_v8,\n    orchestration_transcript_rows_v8,\n    validate_orchestration_transcript_v8,\n)\nfrom .semantic_physical import physical_semantic_episode\nfrom .semantic_primitives import _truthy as _detail_truthy\n\n_UNARY_OPERATORS = {\n    operator: name for name, (arity, operator) in primitives.OPERATIONS.items() if arity == 1\n}\n_BINARY_OPERATORS = {\n    operator: name\n    for name, (arity, operator) in primitives.OPERATIONS.items()\n    if arity == 2 and name not in {\"and\", \"or\", \"coalesce\"}\n}\n\n\nclass NativeV8Error(ValueError):\n    pass\n\n\ndef _fail(msg):\n    raise NativeV8Error(msg)\n\n\ndef _exact(obj, keys, label):\n    if not isinstance(obj, Mapping) or set(obj) != set(keys):\n        _fail(f\"Malformed v8 {label}\")\n\n\ndef validate_v8_artifact(document):\n    \"\"\"Replay public v8 records, causal contexts, and shared continuations.\n\n    The engineering receipt reports replay, context, and continuation checks.\n    Masks, tokenizer, and live source correspondence remain untested here;\n    this function always returns admitted=False.\n    \"\"\"\n    if not isinstance(document, dict) or not isinstance(document.get(\"public\"), dict):\n        _fail(\"Expected semantic-execution/8 public artifact\")\n    public = document[\"public\"]\n    try:\n        timeline = validate_public(public)\n    except SemanticContractV8Error as e:\n        raise NativeV8Error(str(e)) from e\n    contexts = document.get(\"contexts\")\n    if type(contexts) is not list:\n        _fail(\"V8 contexts must be an ordered public list\")\n    generated = [(i, row) for i, row in enumerate(timeline) if row[\"mode\"] == \"generated\"]\n    if len(contexts) != len(generated):\n        _fail(\"Every generated v8 target requires one earlier context\")\n    programs = {}\n    generated_count = 0\n    algorithm_count = 0\n    detail_count = 0\n    region_count = 0\n    protocol_count = 0\n    for context, (_index, row) in zip(contexts, generated, strict=True):\n        _exact(\n            context,\n            {\n                \"schema\",\n                \"representation\",\n                \"profile\",\n                \"invocationId\",\n                \"programs\",\n                \"input\",\n                \"state\",\n                \"regionCursor\",\n                \"obligations\",\n                \"visibleThrough\",\n                \"prefixDigest\",\n            },\n            \"context\",\n        )\n        if (\n            context[\"schema\"] != \"semantic-context/8\"\n            or context[\"representation\"] != \"mixed\"\n            or context[\"profile\"] != \"compositional-regions/1\"\n        ):\n            _fail(\"V8 context version\")\n        cutoff = context[\"visibleThrough\"]\n        if (\n            type(cutoff) is not int\n            or cutoff < 1\n            or cutoff > row[\"sequence\"] - 1\n            or context[\"prefixDigest\"] != stable_algorithm_hash(timeline[:cutoff])\n        ):\n            _fail(\"Context includes future information or has a false prefix digest\")\n        if context[\"invocationId\"] != row[\"fields\"].get(\"invocationId\"):\n            _fail(\"Context invocation mismatch\")\n        state = context[\"state\"]\n        if type(state) is not dict or set(state) != set(\n            __import__(\"megatoken.data.semantic_contract_v8\", fromlist=[\"DEFINITION\"]).DEFINITION[\n                \"sharedStateFields\"\n            ]\n        ):\n            _fail(\"V8 shared continuation fields\")\n        for name in (\n            \"heap\",\n            \"locals\",\n            \"stack\",\n            \"effects\",\n            \"jobs\",\n            \"ready\",\n            \"captureAliases\",\n            \"continuations\",\n            \"frameFunctions\",\n            \"jobErrors\",\n        ):\n            if not isinstance(state[name], list):\n                _fail(\"V8 continuation ordered table\")\n        if any(\n            not isinstance(row, list) or len(row) != 2 or not isinstance(row[0], str)\n            for key in (\"locals\", \"captureAliases\", \"continuations\", \"frameFunctions\")\n            for row in state[key]\n        ):\n            _fail(\"V8 continuation identity table\")\n        try:\n            value_validator = (\n                __import__(\n                    \"megatoken.data.protocol_v8\", fromlist=[\"validate_protocol_value\"]\n                ).validate_protocol_value\n                if state[\"protocol\"] is not None\n                else validate_value\n            )\n            for _, tagged in state[\"locals\"]:\n                value_validator(tagged)\n            value_validator(state[\"receiver\"])\n        except (TypeError, ValueError) as e:\n            raise NativeV8Error(f\"Malformed tagged v8 continuation value: {e}\") from e\n        if state[\"protocol\"] is not None:\n            try:\n                validate_protocol_state(state[\"protocol\"], state[\"heap\"], state)\n            except ProtocolV8Error as e:\n                raise NativeV8Error(f\"Malformed shared protocol state: {e}\") from e\n\n        if (\n            not isinstance(context[\"regionCursor\"], dict)\n            or set(context[\"regionCursor\"]) != {\"active\", \"consumed\"}\n            or not isinstance(context[\"regionCursor\"][\"consumed\"], list)\n        ):\n            _fail(\"V8 region cursor\")\n        if (\n            not isinstance(context[\"obligations\"], dict)\n            or set(context[\"obligations\"]) != {\"intents\", \"handlers\", \"callbacks\", \"closureQueue\"}\n            or any(not isinstance(v, list) for v in context[\"obligations\"].values())\n        ):\n            _fail(\"V8 obligations\")\n        if (\n            not isinstance(context[\"programs\"], list)\n            or not isinstance(context[\"input\"], dict)\n            or not isinstance(context[\"obligations\"], dict)\n        ):\n            _fail(\"V8 context publication/state shape\")\n        for published in context[\"programs\"]:\n            if type(published) is not dict or set(published) != {\"id\", \"program\"}:\n                _fail(\"Program publication\")\n            program = published[\"program\"]\n            if type(program) is not dict or program.get(\"schema\") != \"semantic-region-program/1\":\n                _fail(\"Region program version\")\n            if (\n                program.get(\"sourceDigest\") != stable_algorithm_hash(program.get(\"source\"))\n                or program.get(\"traceFormat\") != \"semantic-trace/8\"\n                or program.get(\"profile\") != \"compositional-regions/1\"\n            ):\n                _fail(\"Program source or profile digest\")\n            if program.get(\"definitionDigest\") != stable_algorithm_hash(\n                {k: v for k, v in program.items() if k != \"definitionDigest\"}\n            ):\n                _fail(\"Region definition digest\")\n            if \"moduleNamespacePlan\" in program:\n                try:\n                    verify_experimental_module_namespace_plan(program[\"moduleNamespacePlan\"])\n                except ValueError as error:\n                    raise NativeV8Error(\n                        f\"Invalid experimental module namespace plan: {error}\"\n                    ) from error\n            source_rows = [\n                r[\"fields\"]\n                for r in timeline[:cutoff]\n                if r[\"kind\"] == \"program\" and r[\"fields\"].get(\"programId\") == published[\"id\"]\n            ]\n            if not source_rows or source_rows[-1].get(\"regionProgram\") != program:\n                _fail(\"Context program was not previously published byte-for-byte\")\n            programs[published[\"id\"]] = program\n        prior_invocations = [\n            r[\"fields\"]\n            for r in timeline[:cutoff]\n            if r[\"kind\"] == \"invocation\"\n            and r[\"fields\"].get(\"invocationId\") == context[\"invocationId\"]\n        ]\n        if not prior_invocations or context[\"input\"].get(\"graph\") != prior_invocations[-1].get(\n            \"inputGraph\"\n        ):\n            _fail(\"Context input graph was not previously observed\")\n        active_context_program = programs.get(prior_invocations[-1].get(\"programId\"))\n        if active_context_program is None:\n            _fail(\"Active invocation program is not publicly available in the context\")\n        namespace_plan = active_context_program.get(\"moduleNamespacePlan\")\n        if state[\"protocol\"] is not None and namespace_plan is not None:\n            try:\n                validate_experimental_module_namespace_shared_state(state, namespace_plan)\n            except ValueError as error:\n                raise NativeV8Error(f\"Malformed shared namespace state: {error}\") from error\n        fields = row[\"fields\"]\n        if row[\"kind\"] in (\"algorithm\", \"region\", \"semantic\", \"protocol\"):\n            # A target must follow a program and invocation publication inside\n            # the exact model-visible prefix. No importer cache can satisfy it.\n            if not context[\"programs\"]:\n                _fail(\"Generated target has no publicly visible region definition\")\n            program = active_context_program\n            if row[\"kind\"] == \"algorithm\":\n                core = program.get(\"algorithm\")\n                if core is None:\n                    _fail(\"Algorithm target lacks its published core\")\n                entry = fields.get(\"entry\")\n                if (\n                    not isinstance(entry, dict)\n                    or type(entry.get(\"visibleThrough\")) is not int\n                    or entry != region_entry_v8(program, context, \"whole\")\n                ):\n                    _fail(\"Stale, malformed, or false algorithm entry\")\n                if (\n                    any(\n                        previous[\"mode\"] == \"generated\"\n                        and previous[\"fields\"].get(\"invocationId\") == context[\"invocationId\"]\n                        for previous in timeline[:cutoff]\n                    )\n                    or state[\"stack\"] != [context[\"invocationId\"]]\n                    or any(\n                        state[name]\n                        for name in (\"completion\", \"pending\", \"effects\", \"jobs\", \"continuations\")\n                    )\n                    or context[\"input\"].get(\"retained\")\n                    or (state.get(\"protocol\") or {}).get(\"sequence\")\n                ):\n                    _fail(\"Whole algorithm requires the untouched invocation entry\")\n                graph = context[\"input\"].get(\"graph\")\n                if not isinstance(graph, dict):\n                    _fail(\"Algorithm target lacks a public input graph\")\n                replay_algorithm_line(core, graph, fields.get(\"line\"))\n                algorithm_count += 1\n            elif row[\"kind\"] == \"region\":\n                _replay_region(\n                    program,\n                    context,\n                    fields.get(\"line\"),\n                    fields.get(\"entry\"),\n                    namespace_plan=program.get(\"moduleNamespacePlan\"),\n                )\n                region_count += 1\n            else:\n                line = fields.get(\"line\")\n                if row[\"kind\"] == \"protocol\":\n                    try:\n                        decode_protocol_record(line)\n                    except ProtocolV8Error as e:\n                        raise NativeV8Error(f\"Invalid v8 protocol record: {e}\") from e\n                    protocol_count += 1\n                else:\n                    if not isinstance(line, str) or not line.startswith(\"detail \"):\n                        _fail(\"V8 semantic record must carry a checked detailed record\")\n                    try:\n                        kind, detail_fields = parse_record(line)\n                    except ValueError as e:\n                        raise NativeV8Error(f\"Invalid v8 detail record: {e}\") from e\n                    detail_count += 1\n            generated_count += 1\n    final_restored = _replay_shared_state(timeline, contexts, programs, roundtrip=True)\n    final_uninterrupted = _replay_shared_state(timeline, contexts, programs, roundtrip=False)\n    if final_restored != final_uninterrupted:\n        _fail(\"Checkpoint restoration changed the final shared continuation\")\n    result = {\n        \"schema\": \"semantic-native-admission/8\",\n        \"contractDigest\": CONTRACT_DIGEST,\n        \"checks\": {\n            \"replay\": \"passed\"\n            if generated_count\n            and algorithm_count + region_count + detail_count + protocol_count == generated_count\n            else \"unsupported\",\n            \"contexts\": \"passed\",\n            \"continuation\": \"passed\",\n            \"masks\": \"untested\",\n            \"sourceBinding\": \"untested\",\n            \"tokenizer\": \"untested\",\n        },\n        \"counts\": {\n            \"contexts\": len(contexts),\n            \"generatedRecords\": generated_count,\n            \"algorithmRecords\": algorithm_count,\n            \"regionRecords\": region_count,\n            \"detailedRecords\": detail_count,\n            \"protocolRecords\": protocol_count,\n        },\n        \"admitted\": False,\n    }\n    sidecar = document.get(\"sidecar\", {})\n    if isinstance(sidecar, dict) and \"orchestrationTranscript\" in sidecar:\n        # Presence is intentional: a null or malformed declaration must refuse,\n        # rather than silently reverting to a naked public artifact.\n        orchestration = validate_orchestration_transcript_v8(document)\n        result[\"checks\"][\"orchestration\"] = \"passed\"\n        result[\"counts\"][\"orchestrationRecords\"] = orchestration[\"recordCount\"]\n        result[\"orchestrationTranscriptDigest\"] = orchestration[\"transcriptDigest\"]\n    return result\n\n\ndef prepare_native_v8_training(document, *, codec, max_positions=8192, max_history=1024):\n    \"\"\"Build the exact native physical rows, masks, token counts and digest.\"\"\"\n    validate_v8_artifact(document)\n    public = document[\"public\"]\n    timeline = public[\"timeline\"]\n    generated = [(i, row) for i, row in enumerate(timeline) if row[\"mode\"] == \"generated\"]\n    contexts = document[\"contexts\"]\n    rows = []\n    transcript_validation = None\n    orchestration_rows = None\n    sidecar = document.get(\"sidecar\", {})\n    if isinstance(sidecar, dict) and \"orchestrationTranscript\" in sidecar:\n        transcript_validation = validate_orchestration_transcript_v8(document)\n        orchestration_rows = orchestration_transcript_rows_v8(transcript_validation)\n    context_for = {\n        row[\"sequence\"]: context for context, (_, row) in zip(contexts, generated, strict=True)\n    }\n    for sequence, row in enumerate(timeline, 1):\n        skip_public_ingress = transcript_validation is not None and sequence <= 2\n        if not skip_public_ingress:\n            if row[\"mode\"] == \"generated\":\n                context = context_for[sequence]\n                rows.append(\n                    (\n                        f\"semantic:v8:context:{sequence}\",\n                        \"system\",\n                        canonical_semantic_observation(context),\n                        False,\n                        None,\n                        (\n                            transcript_validation[\"childTrack\"]\n                            if transcript_validation is not None\n                            else \"assistant\"\n                        ),\n                    )\n                )\n                payload = row[\"fields\"][\"line\"].encode(\"utf-8\")\n                rows.append(\n                    (\n                        f\"semantic:v8:target:{sequence}\",\n                        \"assistant\",\n                        payload,\n                        True,\n                        {\"instruction\": semantic_selection_instruction_v8()},\n                        (\n                            transcript_validation[\"childTrack\"]\n                            if transcript_validation is not None\n                            else \"assistant\"\n                        ),\n                    )\n                )\n            else:\n                role = \"user\" if row[\"kind\"] in {\"program\", \"invocation\"} else \"environment\"\n                owner = \"assistant\"\n                if transcript_validation is not None:\n                    owner = transcript_validation[\"childTrack\"]\n                rows.append(\n                    (\n                        f\"semantic:v8:observation:{sequence}\",\n                        role,\n                        canonical_semantic_observation(row),\n                        False,\n                        None,\n                        owner,\n                    )\n                )\n        if orchestration_rows is not None:\n            for spec in orchestration_rows[\"buckets\"].get(sequence, ()):\n                rows.append(\n                    (\n                        spec[\"recordId\"],\n                        spec[\"role\"],\n                        spec[\"payload\"],\n                        spec[\"policyMask\"],\n                        spec,\n                        spec[\"track\"],\n                    )\n                )\n    logical_records = []\n    meridians = []\n    ids = {}\n    for index, (identity, role, payload, masked, metadata, owner) in enumerate(rows):\n        metadata = metadata or {}\n        rec = PhysicalRecord(\n            identity,\n            role,\n            payload,\n            turn_index=index,\n            logical_id=identity,\n            policy_mask=masked,\n            provenance=metadata.get(\"provenance\", \"unknown\" if masked else \"executed\"),\n            action_id=metadata.get(\"actionId\"),\n            result_of=metadata.get(\"resultOf\"),\n            execution_id=metadata.get(\"executionId\"),\n        )\n        logical_records.append(rec)\n        ids[identity] = identity\n        meridians.append(\n            Meridian(\n                index,\n                (\n                    TrackEvent(\n                        identity,\n                        owner,\n                        \"text\",\n                        index,\n                        role,\n                        instruction=(\n                            metadata.get(\"instruction\") or semantic_selection_instruction_v8()\n                            if masked\n                            else \"\"\n                        ),\n                    ),\n                ),\n            )\n        )\n    dependencies = []\n    for sequence, _ in generated:\n        target = f\"semantic:v8:target:{timeline[sequence]['sequence']}\"\n        context = f\"semantic:v8:context:{timeline[sequence]['sequence']}\"\n        dependencies.append(Dependency(context, target, \"v8-public-context\"))\n    actions = []\n    if orchestration_rows is not None:\n        actions = [\n            LogicalAction(\n                row[\"actionId\"],\n                row[\"callId\"],\n                row[\"toolName\"],\n                stable_algorithm_json(row[\"arguments\"]),\n                (row[\"targetId\"],),\n                row[\"serializedSha256\"],\n                execution_id=row[\"actionId\"],\n                schema_id=ORCHESTRATION_RECORD_SCHEMA,\n            )\n            for row in orchestration_rows[\"actions\"]\n        ]\n        dependencies.extend(Dependency(*edge) for edge in orchestration_rows[\"dependencies\"])\n    digest = stable_algorithm_hash(public)\n    episode_identity = digest\n    if transcript_validation is not None:\n        episode_identity = stable_algorithm_hash(\n            {\n                \"publicDigest\": digest,\n                \"orchestrationTranscriptDigest\": transcript_validation[\"transcriptDigest\"],\n            }\n        )\n    episode = Episode(\n        \"semantic:v8:\" + episode_identity[:24],\n        tuple(logical_records),\n        Lineage(\"semantic-execution-v8\", episode_identity, \"semantic-execution-v8\"),\n        actions=tuple(actions),\n        stream=\"semantic_execution\",\n        supervision=Supervision(\n            annotations_json=json.dumps(\n                {\n                    \"session_metadata\": semantic_execution_metadata_v8(),\n                    \"semantic_execution\": {\n                        \"schema\": \"semantic-execution/8\",\n                        \"representation\": \"mixed\",\n                        \"profile\": \"compositional-regions/1\",\n                    },\n                },\n                separators=(\",\", \":\"),\n            )\n        ),\n        dependencies=tuple(dependencies),\n        tracks=(\n            (\n                TrackSpec(\n                    transcript_validation[\"coordinatorTrack\"],\n                    \"assistant\",\n                    description=\"Execute the declared V8 child tasks and publish their exact results\",\n                ),\n                TrackSpec(\n                    transcript_validation[\"childTrack\"],\n                    \"assistant\",\n                    description=\"Run the exact declared V8 source\",\n                ),\n            )\n            if transcript_validation is not None\n            else (TrackSpec(\"assistant\", \"assistant\"),)\n        ),\n        meridians=tuple(meridians),\n    )\n    episode = physical_semantic_episode(\n        episode,\n        codec=codec,\n        max_positions=max_positions,\n        max_history=max_history,\n        selection_instruction=lambda continuation=False: semantic_selection_instruction_v8(\n            continuation=continuation\n        ),\n        selection_instruction_for_record=lambda record, continuation=False: (\n            orchestration_selection_instruction_v8(continuation=continuation)\n            if record.logical_id.startswith(\"semantic:v8:orchestration:target:\")\n            else semantic_selection_instruction_v8(continuation=continuation)\n        ),\n        emit_context_windows=False,\n    )\n    encoded = encode_episode(episode, codec)\n    token_rows = []\n    generated_tokens = observed_tokens = 0\n    masked_logicals = set()\n    unmasked_targets = set()\n    event_by_record = {\n        event.record_id: event for group in episode.meridians for event in group.events\n    }\n    track_by_id = {track.track_id: track for track in episode.tracks}\n    for item in encoded:\n        record = item.record\n        labels = [\n            token if eligible else -100\n            for token, eligible in zip(item.token_ids, item.free_mask, strict=True)\n        ]\n        if record.policy_mask:\n            generated_tokens += item.P\n            masked_logicals.add(record.logical_id)\n        elif record.logical_id.startswith(\n            (\"semantic:v8:target:\", \"semantic:v8:orchestration:target:\")\n        ):\n            unmasked_targets.add(record.logical_id)\n        else:\n            observed_tokens += item.tokens\n        token_row = {\n            \"recordId\": record.record_id,\n            \"logicalId\": record.logical_id,\n            \"partIndex\": record.part_index,\n            \"partCount\": record.part_count,\n            \"role\": record.role,\n            \"policyMask\": record.policy_mask,\n            \"payloadSha256\": __import__(\"hashlib\").sha256(record.payload).hexdigest(),\n            \"tokenIds\": list(item.token_ids),\n            \"labels\": labels,\n            \"codecFingerprint\": item.codec_fingerprint,\n        }\n        if transcript_validation is not None:\n            event = event_by_record.get(record.record_id)\n            track = track_by_id.get(event.track_id) if event is not None else None\n            token_row.update(\n                provenance=record.provenance,\n                actionId=record.action_id,\n                resultOf=record.result_of,\n                executionId=record.execution_id,\n                instruction=event.instruction if event is not None else \"\",\n                trackId=event.track_id if event is not None else None,\n                trackRole=track.role if track is not None else None,\n                trackDescription=track.description if track is not None else None,\n                eventRole=event.role if event is not None else None,\n                modality=event.modality if event is not None else None,\n            )\n        token_rows.append(token_row)\n    native_digest_body = {\n        \"schema\": \"semantic-native-training/8\",\n        \"codecFingerprint\": codec.fingerprint,\n        \"rows\": token_rows,\n    }\n    if transcript_validation is not None:\n        native_digest_body.update(\n            orchestrationTranscriptDigest=transcript_validation[\"transcriptDigest\"],\n            orchestrationOrigin=transcript_validation[\"transcript\"][\"origin\"],\n            tracks=[\n                {\n                    \"trackId\": track.track_id,\n                    \"role\": track.role,\n                    \"modality\": track.default_modality,\n                    \"description\": track.description,\n                    \"settings\": track.settings_json,\n                }\n                for track in episode.tracks\n            ],\n            dependencies=[\n                {\"writer\": edge.writer_id, \"reader\": edge.reader_id, \"kind\": edge.kind}\n                for edge in episode.dependencies\n            ],\n            actions=[\n                {\n                    \"actionId\": action.action_id,\n                    \"callId\": action.call_id,\n                    \"toolName\": action.tool_name,\n                    \"arguments\": action.arguments_json,\n                    \"records\": list(action.record_ids),\n                    \"serializedSha256\": action.serialized_sha256,\n                    \"executionId\": action.execution_id,\n                    \"schemaId\": action.schema_id,\n                }\n                for action in episode.actions\n            ],\n        )\n    native_digest = stable_algorithm_hash(native_digest_body)\n    expected_targets = {\n        f\"semantic:v8:target:{row['sequence']}\" for row in timeline if row[\"mode\"] == \"generated\"\n    }\n    if orchestration_rows is not None:\n        expected_targets.update(row[\"targetId\"] for row in orchestration_rows[\"actions\"])\n    target_prefixes = (\"semantic:v8:target:\", \"semantic:v8:orchestration:target:\")\n    if masked_logicals != expected_targets or unmasked_targets:\n        raise NativeV8Error(\"Native v8 physical policy masks do not match generated targets\")\n    if any(\n        record.logical_id.startswith(target_prefixes) and not record.policy_mask\n        for record in episode.records\n    ):\n        raise NativeV8Error(\"Native V8 target record lost its policy mask\")\n    result = {\n        \"nativeTrainingDigest\": native_digest,\n        \"generatedTokens\": generated_tokens,\n        \"observedTokens\": observed_tokens,\n        \"physicalRecords\": len(episode.records),\n        \"logicalRecords\": len(rows),\n        \"contexts\": len(contexts),\n        \"generatedRecords\": len(generated),\n        \"eosTokenId\": None,\n        \"terminalTokens\": 0,\n        \"maskValidation\": True,\n        \"framing\": \"native-physical-record-boundaries/1\",\n    }\n    if transcript_validation is not None:\n        result.update(\n            orchestrationRecords=transcript_validation[\"recordCount\"],\n            orchestrationTranscriptDigest=transcript_validation[\"transcriptDigest\"],\n        )\n    return episode, result\n\n\ndef region_entry_v8(program, context, region):\n    \"\"\"Construct host-owned entry metadata from current public authority only.\"\"\"\n    if region == \"whole\":\n        if not isinstance(program.get(\"algorithm\"), dict):\n            _fail(\"Algorithm entry requires a published pure core\")\n        digest = stable_algorithm_hash(program[\"algorithm\"])\n    else:\n        definition = next((item for item in program[\"regions\"] if item.get(\"id\") == region), None)\n        if definition is None:\n            _fail(\"Unknown region definition\")\n        digest = definition[\"digest\"]\n    return {\n        \"definition\": program[\"definitionDigest\"],\n        \"region\": region,\n        \"regionDigest\": digest,\n        \"visibleThrough\": context[\"visibleThrough\"],\n        \"stateDigest\": stable_algorithm_hash(context[\"state\"]),\n    }\n\n\ndef _replay_region(program, context, line, entry, *, namespace_plan=None):\n    if not isinstance(line, str) or not line.startswith(\"region \"):\n        _fail(\"V8 region prefix\")\n    try:\n        target = json.loads(line[len(\"region \") :])\n    except json.JSONDecodeError as e:\n        raise NativeV8Error(\"Malformed region JSON\") from e\n    _exact(target, {\"region\", \"bindings\", \"decisions\", \"completion\"}, \"region target\")\n    if not isinstance(entry, dict) or set(entry) != {\n        \"definition\",\n        \"region\",\n        \"regionDigest\",\n        \"visibleThrough\",\n        \"stateDigest\",\n    }:\n        _fail(\"Trusted region entry fields\")\n    if (\n        entry[\"definition\"] != program[\"definitionDigest\"]\n        or entry[\"stateDigest\"] != stable_algorithm_hash(context[\"state\"])\n        or entry[\"visibleThrough\"] != context[\"visibleThrough\"]\n    ):\n        _fail(\"Stale or false region entry\")\n    definition = next((r for r in program[\"regions\"] if r.get(\"id\") == target[\"region\"]), None)\n    if (\n        definition is None\n        or entry[\"region\"] != definition[\"id\"]\n        or entry[\"regionDigest\"] != definition[\"digest\"]\n    ):\n        _fail(\"Unknown region definition\")\n    if namespace_plan is not None:\n        _fail(\"Compact regions are unsupported with an active module namespace plan\")\n    local_values = {name: value for name, value in context[\"state\"].get(\"locals\", [])}\n    locals_ = {\n        name: local_values.get(cell)\n        for name, cell in context[\"state\"].get(\"captureAliases\", [])\n        if cell in local_values\n    }\n    locals_.update({name: value for name, value in local_values.items() if name not in locals_})\n    values = {}\n    bindings = []\n    decisions = []\n    completion = {\"kind\": definition[\"completion\"]}\n\n    def term(node):\n        op = node.get(\"op\")\n        if op == \"literal\":\n            return node[\"value\"]\n        if op == \"local\":\n            name = node[\"name\"]\n            if name not in values and name not in locals_:\n                _fail(\"Unavailable local at region entry\")\n            return values.get(name, locals_.get(name))\n        if op == \"select\":\n            c = term(node[\"test\"])\n            truth = c[0] == \"symbol\" or _detail_truthy(c)\n            selected = \"consequent\" if truth else \"alternate\"\n            decisions.append({\"kind\": \"select\", \"selected\": selected})\n            return term(node[selected])\n        if op == \"logical\":\n            left = term(node[\"left\"])\n            operator = node[\"operator\"]\n            truth = left[0] == \"symbol\" or _detail_truthy(left)\n            take_right = (\n                (operator == \"&&\" and truth)\n                or (operator == \"||\" and not truth)\n                or (operator == \"??\" and left[0] in (\"null\", \"undefined\"))\n            )\n            decisions.append({\"kind\": operator, \"selected\": \"right\" if take_right else \"left\"})\n            return term(node[\"right\"]) if take_right else left\n        if op in (\"binary\", \"unary\"):\n            operator = node[\"operator\"]\n            mappings = _UNARY_OPERATORS if op == \"unary\" else _BINARY_OPERATORS\n            operation = mappings.get(operator)\n            if operation is None:\n                _fail(\"Unsupported local primitive operator\")\n            from . import semantic_primitives as primitives\n\n            args = (\n                [term(node[\"arg\"])] if op == \"unary\" else [term(node[\"left\"]), term(node[\"right\"])]\n            )\n            return primitives._operation(operation, args)\n        _fail(\"Unsupported local term\")\n\n    for op in definition[\"operations\"]:\n        if op[\"kind\"] == \"bind\":\n            value = term(op[\"term\"])\n            values[op[\"binding\"]] = value\n            bindings.append([op[\"binding\"], value])\n        elif op[\"kind\"] == \"return\":\n            completion = {\"kind\": \"return\", \"value\": term(op[\"term\"])}\n        else:\n            _fail(\"Unsupported compact region operation\")\n    expected = {\n        \"region\": definition[\"id\"],\n        \"bindings\": bindings,\n        \"decisions\": decisions,\n        \"completion\": completion,\n    }\n    if target != expected:\n        _fail(\"Region target disagrees with independent local replay\")\n    return target\n\n\ndef _invocation_bindings(function, invocation):\n    roots = invocation.get(\"inputGraph\", {}).get(\"roots\", [])\n    params = function.get(\"params\", [])\n    if not isinstance(params, list) or any(\n        name is not None and (not isinstance(name, str) or not name) for name in params\n    ):\n        _fail(\"Malformed published parameter bindings\")\n    # Default/rest/pattern parameters are published as null. Their cells are\n    # initialized by later checked records, not by the positional input graph.\n    bindings = {\n        name: copy.deepcopy(roots[index] if index < len(roots) else [\"undefined\"])\n        for index, name in enumerate(params)\n        if name is not None\n    }\n    declared = invocation.get(\"bindings\", {})\n    if not isinstance(declared, dict):\n        _fail(\"Malformed invocation bindings\")\n    for name, index in declared.items():\n        if (\n            not isinstance(name, str)\n            or not name\n            or type(index) is not int\n            or not 0 <= index < len(roots)\n        ):\n            _fail(\"Invocation binding has no observed argument\")\n    # Published parameter order owns the first cells. Extra explicit names\n    # use JavaScript UTF-16 lexical order so canonical JSON cannot change\n    # capture identities; replacing a parameter value keeps its original slot.\n    for name in sorted(declared, key=lambda key: key.encode(\"utf-16-be\", \"surrogatepass\")):\n        bindings[name] = copy.deepcopy(roots[declared[name]])\n    return bindings\n\n\ndef _closure_entry_function(functions, entry, closure):\n    \"\"\"Bind both public spellings to the same immutable source function site.\"\"\"\n    if not isinstance(closure, dict) or closure.get(\"kind\") != \"closure\":\n        _fail(\"Closure invocation has no published guest closure\")\n\n    def resolve(reference):\n        matches = [\n            function\n            for function in functions\n            if isinstance(function, dict)\n            and isinstance(reference, str)\n            and (\n                function.get(\"name\") == reference\n                or \"function:\" + str(function.get(\"start\")) == reference\n            )\n        ]\n        if len(matches) != 1 or type(matches[0].get(\"start\")) is not int or matches[0][\"start\"] < 0:\n            _fail(\"Closure entry must resolve to one immutable function site\")\n        return matches[0]\n\n    selected = resolve(entry)\n    declared = resolve(closure.get(\"code\"))\n    if selected[\"start\"] != declared[\"start\"]:\n        _fail(\"Closure entry differs from its immutable function site\")\n    return selected\n\n\ndef _initial_state(\n    program,\n    invocation,\n    functions=(),\n    random_seed=None,\n    *,\n    retained_state=None,\n    invocation_ordinal=0,\n):\n    graph = invocation.get(\"inputGraph\")\n    if not isinstance(graph, dict) or set(graph) != {\"roots\", \"objects\"}:\n        _fail(\"Invocation input graph\")\n    from .semantic_records import graph as validate_graph\n\n    heap = copy.deepcopy(retained_state[\"heap\"]) if retained_state is not None else []\n    retained = {identity for identity, _ in heap}\n    try:\n        validate_graph(graph, retained=retained)\n    except ValueError as error:\n        raise NativeV8Error(\"Invalid invocation input graph: \" + str(error)) from error\n    for node in graph[\"objects\"]:\n        if node[\"id\"] in retained:\n            _fail(\"Invocation graph overwrites a retained heap identity\")\n        row = {\n            \"kind\": node[\"kind\"],\n            \"prototype\": node.get(\"prototype\", \"ordinary\"),\n            \"properties\": [[p[\"key\"], p[\"value\"]] for p in node[\"properties\"]],\n        }\n        heap.append([node[\"id\"], row])\n    receiver = invocation.get(\"receiver\", [\"undefined\"])\n    if receiver[0] == \"ref\" and receiver[1] not in dict(heap):\n        _fail(\"Invocation receiver references an unknown identity\")\n    closure_id = invocation.get(\"closureId\")\n    closure = dict(heap).get(closure_id) if closure_id is not None else None\n    fn = (\n        _closure_entry_function(functions, invocation.get(\"entry\"), closure)\n        if closure_id is not None\n        else next(\n            (\n                f\n                for f in functions\n                if f.get(\"name\") == invocation.get(\"entry\")\n                or \"function:\" + str(f.get(\"start\")) == invocation.get(\"entry\")\n            ),\n            {},\n        )\n    )\n    locals_ = copy.deepcopy(retained_state[\"locals\"]) if retained_state is not None else []\n    aliases = [\n        [capture[\"binding\"], capture[\"cell\"]] for capture in (closure or {}).get(\"captures\", [])\n    ]\n    ordinal = 0\n    for name, tagged in _invocation_bindings(fn, invocation).items():\n        cell = f\"a{invocation_ordinal}b{ordinal}\"\n        while cell in dict(locals_):\n            ordinal += 1\n            cell = f\"a{invocation_ordinal}b{ordinal}\"\n        ordinal += 1\n        _set_row(locals_, cell, tagged)\n        _set_row(aliases, name, cell)\n    if any(cell not in dict(locals_) for _, cell in aliases):\n        _fail(\"Closure captures an unavailable retained cell\")\n    if random_seed is not None and (\n        type(random_seed) is not int or not 0 <= random_seed <= 0xFFFFFFFF\n    ):\n        _fail(\"Malformed deterministic random seed\")\n    return {\n        \"heap\": heap,\n        \"locals\": locals_,\n        \"stack\": [invocation[\"invocationId\"]],\n        \"effects\": [],\n        \"jobs\": [],\n        \"ready\": [],\n        \"randomState\": retained_state[\"randomState\"]\n        if retained_state is not None and random_seed is not None\n        else random_seed,\n        \"pending\": None,\n        \"lastReturn\": None,\n        \"completion\": None,\n        \"receiver\": copy.deepcopy(receiver),\n        \"captureAliases\": aliases,\n        \"continuations\": [],\n        \"reactionSequence\": 0,\n        \"blockedSync\": None,\n        \"callReturn\": None,\n        \"activeJob\": None,\n        \"scheduler\": copy.deepcopy(retained_state[\"scheduler\"])\n        if retained_state is not None\n        else {\"registration\": 0, \"ready\": 0},\n        \"frameFunctions\": [[invocation[\"invocationId\"], invocation[\"entry\"]]],\n        \"jobErrors\": [],\n        \"protocol\": None,\n    }\n\n\ndef _replay_shared_state(\n    timeline, contexts, programs_from_context, *, roundtrip, boundary_invocation=None\n):\n    snapshots = {\n        row[\"sequence\"]: ctx\n        for ctx, (_, row) in zip(\n            contexts,\n            [(i, r) for i, r in enumerate(timeline) if r[\"mode\"] == \"generated\"],\n            strict=True,\n        )\n    }\n    published = {}\n    state = None\n    program = None\n    dispatched = set()\n    settled = set()\n    consumed = []\n    obligations = {\"intents\": [], \"handlers\": [], \"callbacks\": [], \"closureQueue\": []}\n    task_revisions = {}\n    owner_sequences = {}\n    track_sequences = {}\n    controllers = {}\n    active_invocation = None\n    completion_policy = \"call-return\"\n    completion_policies = {}\n    functions = []\n    invocation_inputs = {}\n    invocation_metadata = {}\n    ingress_keys = set()\n    callback_allocator = [0]\n    event_allocator = 0\n    pending_event = None\n    pending_reconciliation = None\n    cancelled_invocations = set()\n    closed_realms = set()\n\n    def share_realm(owner, source):\n        realm = invocation_metadata[owner][\"realmId\"]\n        for identity, saved in controllers.items():\n            if invocation_metadata[identity][\"realmId\"] == realm:\n                _merge_callback_state(saved, source)\n\n    def same_realm(first, second):\n        return (\n            first is not None\n            and second is not None\n            and invocation_metadata[first][\"realmId\"] == invocation_metadata[second][\"realmId\"]\n        )\n\n    for prior in timeline:\n        track = prior.get(\"fields\", {}).get(\"track\")\n        track_sequences[track] = track_sequences.get(track, 0) + 1\n        owner_sequences[prior[\"sequence\"]] = track_sequences[track]\n    for row in timeline:\n        kind = row[\"kind\"]\n        fields = row[\"fields\"]\n        if row[\"mode\"] == \"observed\":\n            from .observations_v8 import validate_observation_v8\n\n            try:\n                validate_observation_v8(row)\n            except ValueError as error:\n                raise NativeV8Error(str(error)) from error\n        if pending_event is not None and (\n            kind != \"invocation\" or fields.get(\"invocationId\") != pending_event[\"invocationId\"]\n        ):\n            _fail(\"Event delivery must be followed by its exact callback invocation\")\n        if pending_reconciliation is not None:\n            if kind != \"result\" or any(\n                fields.get(key) != value for key, value in pending_reconciliation.items()\n            ):\n                _fail(\"Reconciliation must be followed by its exact observed result\")\n            pending_reconciliation = None\n        previous_readiness = {\n            invocation_metadata[identity][\"realmId\"]: saved[\"scheduler\"][\"ready\"]\n            for identity, saved in controllers.items()\n        }\n        if kind == \"program\":\n            program = fields.get(\"regionProgram\")\n            if not isinstance(program, dict):\n                _fail(\"Program record omits its immutable region definition\")\n            if fields.get(\"digest\") != program.get(\"sourceDigest\") or program.get(\n                \"source\"\n            ) != fields.get(\"source\"):\n                _fail(\"Public region definition differs from immutable source publication\")\n            random_seed = fields.get(\"randomSeed\")\n            if \"randomSeed\" in fields and (\n                type(random_seed) is not int or not 0 <= random_seed <= 0xFFFFFFFF\n            ):\n                _fail(\"Malformed deterministic random seed\")\n            published[fields[\"programId\"]] = (program, fields.get(\"functions\", []), random_seed)\n            continue\n        if kind == \"invocation\":\n            if fields[\"realmId\"] in closed_realms:\n                _fail(\"Closed realm cannot be resurrected\")\n            if fields[\"invocationId\"] in controllers:\n                _fail(\"Duplicate invocation controller\")\n            if fields[\"ingressKey\"] in ingress_keys:\n                _fail(\"Ingress key already owns another invocation\")\n            published_row = published.get(fields[\"programId\"])\n            if published_row is None:\n                _fail(\"Invocation has no preceding program\")\n            program, functions, random_seed = published_row\n            if fields.get(\"sourceDigest\") != program.get(\"sourceDigest\"):\n                _fail(\"Invocation source/definition binding\")\n            retained_owner = next(\n                (\n                    identity\n                    for identity in reversed(controllers)\n                    if invocation_metadata[identity][\"realmId\"] == fields[\"realmId\"]\n                ),\n                None,\n            )\n            base = controllers.get(retained_owner)\n            if base is not None:\n                if fields.get(\"realmPolicy\") != \"retained\":\n                    _fail(\"Fresh realm identity cannot be reused\")\n                previous = invocation_metadata[retained_owner]\n                if (\n                    previous[\"sourceDigest\"] != program.get(\"sourceDigest\")\n                    or published[previous[\"programId\"]][2] != random_seed\n                ):\n                    _fail(\"Retained invocation differs from its realm source or seed\")\n                if fields[\"taskRevision\"] < previous[\"taskRevision\"]:\n                    _fail(\"Retained invocation has a stale task revision\")\n                if any(\n                    saved[\"stack\"]\n                    for identity, saved in controllers.items()\n                    if invocation_metadata[identity][\"realmId\"] == fields[\"realmId\"]\n                    and identity not in cancelled_invocations\n                ):\n                    _fail(\"Invocation cannot interrupt a running JavaScript stack\")\n            owner = fields.get(\"parentInvocationId\")\n            if owner is not None and (owner not in controllers or owner in cancelled_invocations):\n                _fail(\"Child has no live owning invocation\")\n            if fields.get(\"closureId\") is not None:\n                # Resolve before importing inputs or allocating captured cells.\n                # The observed entry cannot redirect a re