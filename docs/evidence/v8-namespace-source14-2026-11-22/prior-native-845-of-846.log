      identity = transition.get(\"namespaceId\")\n        if not isinstance(identity, str) or not _ID.fullmatch(identity):\n            _fail(\"namespace identity\")\n        expected = _verify_namespace(next_heap.get(identity), identity, plan)\n        if kind == \"namespace.keys\":\n            if not _exact(transition, {\"kind\", \"namespaceId\", \"names\", \"resultId\"}):\n                _fail(\"namespace keys fields\")\n            names = [item[\"name\"] for item in expected[\"exports\"]]\n            if transition[\"names\"] != names:\n                _fail(\"namespace keys differ from source order\")\n            for item in expected[\"exports\"]:\n                storage = _resolved(shared_state, item[\"loweredName\"])\n                if storage not in next_locals:\n                    _fail(\"TDZ Object.keys namespace inspection\")\n                if not _canonical_value(next_locals[storage]):\n                    _fail(\"Object.keys namespace export is outside scalar subset\")\n            result_id = transition[\"resultId\"]\n            _fresh(next_heap, result_id, shared_state)\n            next_heap[result_id] = _ordinary_result(\n                \"array\",\n                [[str(index), [\"str\", name]] for index, name in enumerate(names)],\n                len(names),\n            )\n        else:\n            fields = (\n                {\"kind\", \"namespaceId\", \"exportName\", \"value\"}\n                if kind == \"namespace.read\"\n                else {\"kind\", \"namespaceId\", \"exportName\", \"value\", \"resultId\"}\n            )\n            if not _exact(transition, fields):\n                _fail(\"namespace value fields\")\n            export = next(\n                (item for item in expected[\"exports\"] if item[\"name\"] == transition[\"exportName\"]),\n                None,\n            )\n            if export is None:\n                _fail(\"namespace export absent\")\n            storage = _resolved(shared_state, export[\"loweredName\"])\n            if storage not in next_locals:\n                _fail(\"TDZ namespace read\")\n            current = next_locals[storage]\n            if not _canonical_value(current):\n                _fail(\"namespace cell is outside scalar experimental subset\")\n            if kind == \"namespace.read\":\n                if transition[\"value\"] != current:\n                    _fail(\"namespace read differs from current source cell\")\n            else:\n                descriptor = {\n                    \"value\": copy.deepcopy(current),\n                    \"writable\": True,\n                    \"enumerable\": True,\n                    \"configurable\": False,\n                }\n                if transition[\"value\"] != descriptor:\n                    _fail(\"namespace descriptor differs from current source cell\")\n                result_id = transition[\"resultId\"]\n                _fresh(next_heap, result_id, shared_state)\n                next_heap[result_id] = _ordinary_result(\n                    \"object\",\n                    [\n                        [\"value\", copy.deepcopy(current)],\n                        [\"writable\", [\"bool\", True]],\n                        [\"enumerable\", [\"bool\", True]],\n                        [\"configurable\", [\"bool\", False]],\n                    ],\n                )\n    else:\n        _fail(\"unsupported shared namespace transition\")\n\n    result = copy.deepcopy(shared_state)\n    result[\"heap\"] = _pairs(next_heap)\n    result[\"locals\"] = _pairs(next_locals)\n    return result\n\n\ndef validate_experimental_module_namespace_shared_state(shared_state: Any, plan: Any) -> bool:\n    verify_experimental_module_namespace_plan(plan)\n    if not isinstance(shared_state, dict):\n        _fail(\"shared machine state\")\n    heap = _table(shared_state.get(\"heap\"), \"heap\")\n    locals_map = _table(shared_state.get(\"locals\"), \"locals\")\n    seen_files, seen_names = set(), set()\n    for identity, node in heap.items():\n        if isinstance(node, dict) and node.get(\"kind\") == \"module-namespace\":\n            if not isinstance(identity, str) or not _ID.fullmatch(identity):\n                _fail(\"namespace identity\")\n            expected = _verify_namespace(node, identity, plan)\n            if expected[\"file\"] in seen_files or expected[\"namespaceName\"] in seen_names:\n                _fail(\"duplicate namespace identity\")\n            seen_files.add(expected[\"file\"])\n            seen_names.add(expected[\"namespaceName\"])\n            storage = _resolved(shared_state, expected[\"namespaceName\"])\n            if locals_map.get(storage) != [\"ref\", identity]:\n                _fail(\"restored namespace owner binding differs from heap identity\")\n    namespace_cells = {\n        export[\"cell\"]\n        for namespace_row in plan[\"namespaces\"]\n        for export in namespace_row[\"exports\"]\n    }\n    for cell in plan[\"cells\"]:\n        if cell[\"id\"] not in namespace_cells:\n            continue\n        storage = _resolved(shared_state, cell[\"loweredName\"])\n        if storage in locals_map and not _canonical_value(locals_map[storage]):\n            _fail(\"source cell is outside scalar experimental subset\")\n    return True\n\n\ndef assert_experimental_module_namespace_state_unchanged(\n    before: Any, after: Any, plan: Any\n) -> bool:\n    \"\"\"Protect shared cell/owner locals from every non-namespace transition.\"\"\"\n    verify_experimental_module_namespace_plan(plan)\n    if not isinstance(before, dict) or not isinstance(after, dict):\n        _fail(\"shared namespace transition snapshots\")\n    before_locals = _table(before.get(\"locals\"), \"locals\")\n    after_locals = _table(after.get(\"locals\"), \"locals\")\n    before_aliases = _table(before.get(\"captureAliases\", []), \"capture alias\")\n    after_aliases = _table(after.get(\"captureAliases\", []), \"capture alias\")\n    protected = {\n        cell[\"loweredName\"]\n        for cell in plan[\"cells\"]\n        if any(\n            export[\"cell\"] == cell[\"id\"]\n            for namespace in plan[\"namespaces\"]\n            for export in namespace[\"exports\"]\n        )\n    }\n    protected.update(namespace[\"namespaceName\"] for namespace in plan[\"namespaces\"])\n    missing = object()\n    for name in protected:\n        left_storage = before_aliases.get(name, name)\n        right_storage = after_aliases.get(name, name)\n        if left_storage != right_storage:\n            _fail(\"non-namespace transition changed a protected capture alias\")\n        left = before_locals.get(left_storage, missing)\n        right = after_locals.get(right_storage, missing)\n        if left is missing and right is missing:\n            continue\n        if left is missing or right is missing or left != right:\n            _fail(\"non-namespace transition changed a live namespace owner or source cell\")\n    before_heap = _table(before.get(\"heap\"), \"heap\")\n    after_heap = _table(after.get(\"heap\"), \"heap\")\n    left_nodes = {\n        identity: node\n        for identity, node in before_heap.items()\n        if isinstance(node, dict) and node.get(\"kind\") == \"module-namespace\"\n    }\n    right_nodes = {\n        identity: node\n        for identity, node in after_heap.items()\n        if isinstance(node, dict) and node.get(\"kind\") == \"module-namespace\"\n    }\n    if left_nodes != right_nodes:\n        _fail(\"non-namespace transition changed an exotic namespace heap node\")\n    validate_experimental_module_namespace_shared_state(after, plan)\n    return True\n"}
2026-11-22T07:31:55.1903324Z FORMATTED_SOURCE_JSON {"path": "tests/test_module_namespace_state_v8.py", "content": "\"\"\"Controls for experimental, non-admitted module namespace state parity.\"\"\"\n\nfrom copy import deepcopy\n\nimport pytest\n\nfrom megatoken.data.module_namespace_state_v8 import (\n    apply_experimental_module_namespace_transition,\n    build_experimental_module_namespace_plan,\n    create_experimental_module_namespace_state,\n    verify_experimental_module_namespace_plan,\n)\nfrom megatoken.data.semantic_json import stable_algorithm_hash\n\nMODULES = {\n    \"main.js\": 'import * as ns from \"./cells.js\"; export function run(){ return Object.keys(ns); }',\n    \"cells.js\": \"export let value=1; export {value as alias}; export const fixed=2;\",\n}\nCELLS = [\n    {\n        \"file\": \"cells.js\",\n        \"local\": \"value\",\n        \"kind\": \"let\",\n        \"mutable\": True,\n        \"loweredName\": \"__traced_eval_m1_value\",\n    },\n    {\n        \"file\": \"cells.js\",\n        \"local\": \"fixed\",\n        \"kind\": \"const\",\n        \"mutable\": False,\n        \"loweredName\": \"__traced_eval_m1_fixed\",\n    },\n]\nNAMESPACES = [\n    {\n        \"file\": \"cells.js\",\n        \"namespaceName\": \"__traced_eval_namespace_0\",\n        \"exports\": [\n            {\"name\": \"alias\", \"file\": \"cells.js\", \"local\": \"value\"},\n            {\"name\": \"fixed\", \"file\": \"cells.js\", \"local\": \"fixed\"},\n            {\"name\": \"value\", \"file\": \"cells.js\", \"local\": \"value\"},\n        ],\n    }\n]\n\n\ndef _plan(**changes):\n    fields = {\n        \"modules\": MODULES,\n        \"entry_module\": \"main.js\",\n        \"namespaces\": NAMESPACES,\n        \"cells\": CELLS,\n    }\n    fields.update(changes)\n    return build_experimental_module_namespace_plan(**fields)\n\n\ndef test_plan_hashes_sources_and_live_aliases_read_current_cell():\n    plan = _plan()\n    assert verify_experimental_module_namespace_plan(plan)\n    body = {key: value for key, value in plan.items() if key != \"digest\"}\n    assert plan[\"digest\"] == stable_algorithm_hash(body)\n\n    state = create_experimental_module_namespace_state(\n        plan,\n        {\n            \"cells.js#value\": {\"initialized\": True, \"value\": [\"num\", 1]},\n            \"cells.js#fixed\": {\"initialized\": True, \"value\": [\"num\", 2]},\n        },\n    )\n    created = apply_experimental_module_namespace_transition(\n        plan,\n        state,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o1\", \"moduleFile\": \"cells.js\"},\n    )\n    listed = apply_experimental_module_namespace_transition(\n        plan,\n        created[\"state\"],\n        {\"kind\": \"namespace.keys\", \"namespaceId\": \"o1\", \"names\": [\"alias\", \"fixed\", \"value\"]},\n    )\n    assert listed[\"result\"] == [\"alias\", \"fixed\", \"value\"]\n    written = apply_experimental_module_namespace_transition(\n        plan,\n        listed[\"state\"],\n        {\"kind\": \"cell.write\", \"cell\": \"cells.js#value\", \"value\": [\"num\", 9]},\n    )\n    read = apply_experimental_module_namespace_transition(\n        plan,\n        written[\"state\"],\n        {\"kind\": \"namespace.read\", \"namespaceId\": \"o1\", \"exportName\": \"alias\", \"value\": [\"num\", 9]},\n    )\n    assert read[\"result\"] == [\"num\", 9]\n    descriptor = {\n        \"value\": [\"num\", 9],\n        \"writable\": True,\n        \"enumerable\": True,\n        \"configurable\": False,\n    }\n    observed = apply_experimental_module_namespace_transition(\n        plan,\n        read[\"state\"],\n        {\n            \"kind\": \"namespace.descriptor\",\n            \"namespaceId\": \"o1\",\n            \"exportName\": \"value\",\n            \"value\": descriptor,\n        },\n    )\n    assert observed[\"result\"] == descriptor\n\n\ndef test_utf16_export_sort_and_numeric_index_names_match_javascript_order():\n    names = [\"\ud800\udc00\", \"\ue000\"]\n    plan = build_experimental_module_namespace_plan(\n        modules={\"main.js\": \"\", \"cells.js\": \"\"},\n        entry_module=\"main.js\",\n        cells=[\n            {\n                \"file\": \"cells.js\",\n                \"local\": \"value\",\n                \"kind\": \"var\",\n                \"mutable\": True,\n                \"loweredName\": \"__traced_eval_m1_value\",\n            }\n        ],\n        namespaces=[\n            {\n                \"file\": \"cells.js\",\n                \"namespaceName\": \"__traced_eval_namespace_0\",\n                \"exports\": [{\"name\": name, \"file\": \"cells.js\", \"local\": \"value\"} for name in names],\n            }\n        ],\n    )\n    assert [row[\"name\"] for row in plan[\"namespaces\"][0][\"exports\"]] == names\n    with pytest.raises(ValueError, match=\"malformed\"):\n        build_experimental_module_namespace_plan(\n            modules={\"main.js\": \"\", \"cells.js\": \"\"},\n            entry_module=\"main.js\",\n            cells=[\n                {\n                    \"file\": \"cells.js\",\n                    \"local\": \"value\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m1_value\",\n                }\n            ],\n            namespaces=[\n                {\n                    \"file\": \"cells.js\",\n                    \"namespaceName\": \"__traced_eval_namespace_0\",\n                    \"exports\": [{\"name\": \"4294967294\", \"file\": \"cells.js\", \"local\": \"value\"}],\n                }\n            ],\n        )\n\n\ndef test_tdz_const_writes_and_failed_transitions_leave_input_unchanged():\n    plan = _plan()\n    initial = create_experimental_module_namespace_state(plan)\n    created = apply_experimental_module_namespace_transition(\n        plan,\n        initial,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o1\", \"moduleFile\": \"cells.js\"},\n    )[\"state\"]\n    snapshot = deepcopy(created)\n    with pytest.raises(ValueError, match=\"before its source binding is initialized\"):\n        apply_experimental_module_namespace_transition(\n            plan,\n            created,\n            {\n                \"kind\": \"namespace.read\",\n                \"namespaceId\": \"o1\",\n                \"exportName\": \"value\",\n                \"value\": [\"num\", 1],\n            },\n        )\n    assert created == snapshot\n    initialized = apply_experimental_module_namespace_transition(\n        plan,\n        created,\n        {\"kind\": \"cell.initialize\", \"cell\": \"cells.js#fixed\", \"value\": [\"num\", 2]},\n    )[\"state\"]\n    with pytest.raises(ValueError, match=\"write is not allowed\"):\n        apply_experimental_module_namespace_transition(\n            plan,\n            initialized,\n            {\"kind\": \"cell.write\", \"cell\": \"cells.js#fixed\", \"value\": [\"num\", 3]},\n        )\n    assert initialized[\"cells\"][\"cells.js#fixed\"][\"value\"] == [\"num\", 2]\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\n        [\"bigint\", \"-0\"],\n        [\"bigint\", \"+1\"],\n        [\"num\", \"Infinity\"],\n        [\"num\", float(\"nan\")],\n        [\"num\", True],\n        [\"bool\", 1],\n        [\"undefined\", None],\n        [\"null\", None],\n        [\"str\", 1],\n        [\"object\", \"not scalar\"],\n    ],\n)\ndef test_malformed_or_noncanonical_scalar_tags_are_refused(value):\n    with pytest.raises(ValueError, match=\"initial cell value is malformed\"):\n        create_experimental_module_namespace_state(\n            _plan(),\n            {\"cells.js#value\": {\"initialized\": True, \"value\": value}},\n        )\n\n\ndef test_namespace_observation_and_plan_tampering_are_refused():\n    plan = _plan()\n    changed = deepcopy(plan)\n    changed[\"modules\"][0][\"sourceDigest\"] = stable_algorithm_hash(\"changed\")\n    with pytest.raises(ValueError, match=\"integrity differs\"):\n        verify_experimental_module_namespace_plan(changed)\n\n    state = create_experimental_module_namespace_state(plan)\n    with pytest.raises(ValueError, match=\"malformed\"):\n        apply_experimental_module_namespace_transition(\n            plan,\n            state,\n            {\n                \"kind\": \"namespace.create\",\n                \"namespaceId\": \"o1\",\n                \"moduleFile\": \"cells.js\",\n                \"extra\": True,\n            },\n        )\n    assert state[\"namespaces\"] == {}\n\n\ndef test_bad_cell_and_namespace_state_shapes_refuse_without_mutation():\n    plan = _plan()\n    state = create_experimental_module_namespace_state(plan)\n    forged = deepcopy(state)\n    forged[\"cells\"][\"cells.js#value\"][\"version\"] = -1\n    with pytest.raises(ValueError, match=\"source cell state is malformed\"):\n        apply_experimental_module_namespace_transition(\n            plan,\n            forged,\n            {\"kind\": \"namespace.create\", \"namespaceId\": \"o1\", \"moduleFile\": \"cells.js\"},\n        )\n    malformed = deepcopy(state)\n    malformed[\"namespaces\"][\"o1\"] = {\n        \"file\": \"cells.js\",\n        \"namespaceName\": \"__traced_eval_namespace_0\",\n        \"exports\": [],\n    }\n    with pytest.raises(ValueError, match=\"namespace identity state is malformed\"):\n        apply_experimental_module_namespace_transition(\n            plan,\n            malformed,\n            {\"kind\": \"namespace.keys\", \"namespaceId\": \"o1\", \"names\": []},\n        )\n\n\n@pytest.mark.parametrize(\n    \"value\",\n    [\n        [\"undefined\"],\n        [\"null\"],\n        [\"bool\", False],\n        [\"str\", \"live\"],\n        [\"bigint\", \"0\"],\n        [\"bigint\", \"-9007199254740993\"],\n        [\"num\", 0.0],\n        [\"num\", 2**60],\n        [\"num\", \"-0\"],\n        [\"num\", \"NaN\"],\n        [\"num\", \"+Infinity\"],\n        [\"num\", \"-Infinity\"],\n        [\"num\", 1.25],\n    ],\n)\ndef test_canonical_scalar_tags_are_accepted(value):\n    state = create_experimental_module_namespace_state(\n        _plan(),\n        {\"cells.js#value\": {\"initialized\": True, \"value\": value}},\n    )\n    assert state[\"cells\"][\"cells.js#value\"][\"value\"] == value\n\n\ndef test_explicit_null_initial_cells_is_not_the_omitted_default():\n    with pytest.raises(ValueError, match=\"initial cells are malformed\"):\n        create_experimental_module_namespace_state(_plan(), None)\n\n\n@pytest.mark.parametrize(\"value\", [[\"num\", -0.0], [\"num\", 9007199254740993]])\ndef test_noncanonical_negative_zero_and_inexact_js_integers_are_refused(value):\n    with pytest.raises(ValueError, match=\"initial cell value is malformed\"):\n        create_experimental_module_namespace_state(\n            _plan(),\n            {\"cells.js#value\": {\"initialized\": True, \"value\": value}},\n        )\n\n\ndef test_lowered_cell_names_match_local_and_uniquely_identify_each_module():\n    base = {\n        \"modules\": {\"main.js\": \"\", \"cells.js\": \"\", \"other.js\": \"\"},\n        \"entry_module\": \"main.js\",\n        \"namespaces\": [],\n    }\n    with pytest.raises(ValueError, match=\"malformed\"):\n        build_experimental_module_namespace_plan(\n            **base,\n            cells=[\n                {\n                    \"file\": \"cells.js\",\n                    \"local\": \"value\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m1_different\",\n                }\n            ],\n        )\n    with pytest.raises(ValueError, match=\"lowered binding\"):\n        build_experimental_module_namespace_plan(\n            **base,\n            cells=[\n                {\n                    \"file\": \"cells.js\",\n                    \"local\": \"value\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m1_value\",\n                },\n                {\n                    \"file\": \"cells.js\",\n                    \"local\": \"other\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m2_other\",\n                },\n            ],\n        )\n    with pytest.raises(ValueError, match=\"lowered binding\"):\n        build_experimental_module_namespace_plan(\n            **base,\n            cells=[\n                {\n                    \"file\": \"cells.js\",\n                    \"local\": \"value\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m1_value\",\n                },\n                {\n                    \"file\": \"other.js\",\n                    \"local\": \"other\",\n                    \"kind\": \"let\",\n                    \"mutable\": True,\n                    \"loweredName\": \"__traced_eval_m1_other\",\n                },\n            ],\n        )\n"}
2026-11-22T07:31:55.1971531Z FORMATTED_SOURCE_JSON {"path": "tests/test_module_namespace_machine_v8.py", "content": "\"\"\"Controls for shared heap namespace operations and live source locals.\"\"\"\n\nimport json\nfrom copy import deepcopy\n\nimport pytest\n\nfrom megatoken.data.module_namespace_machine_v8 import (\n    apply_experimental_module_namespace_shared_transition as apply,\n)\nfrom megatoken.data.module_namespace_machine_v8 import (\n    assert_experimental_module_namespace_state_unchanged,\n)\nfrom megatoken.data.module_namespace_machine_v8 import (\n    validate_experimental_module_namespace_shared_state as validate_state,\n)\nfrom megatoken.data.module_namespace_state_v8 import build_experimental_module_namespace_plan\nfrom megatoken.data.protocol_v8 import apply_protocol_to_shared_state, encode_protocol_record\n\n\ndef plan():\n    return build_experimental_module_namespace_plan(\n        modules={\n            \"main.js\": \"import * as ns from './cells.js';\",\n            \"cells.js\": \"export let value=1; export {value as alias};\",\n        },\n        entry_module=\"main.js\",\n        cells=[\n            {\n                \"file\": \"cells.js\",\n                \"local\": \"value\",\n                \"kind\": \"let\",\n                \"mutable\": True,\n                \"loweredName\": \"__traced_eval_m1_value\",\n            },\n            {\n                \"file\": \"cells.js\",\n                \"local\": \"fixed\",\n                \"kind\": \"const\",\n                \"mutable\": False,\n                \"loweredName\": \"__traced_eval_m1_fixed\",\n            },\n        ],\n        namespaces=[\n            {\n                \"file\": \"cells.js\",\n                \"namespaceName\": \"__traced_eval_namespace_0\",\n                \"exports\": [\n                    {\"name\": \"alias\", \"file\": \"cells.js\", \"local\": \"value\"},\n                    {\"name\": \"fixed\", \"file\": \"cells.js\", \"local\": \"fixed\"},\n                    {\"name\": \"value\", \"file\": \"cells.js\", \"local\": \"value\"},\n                ],\n            }\n        ],\n    )\n\n\ndef initial():\n    return {\n        \"heap\": [],\n        \"locals\": [\n            [\"__traced_eval_m1_value\", [\"num\", 1]],\n            [\"__traced_eval_m1_fixed\", [\"num\", 2]],\n        ],\n        \"captureAliases\": [],\n        \"frameFunctions\": [],\n        \"stack\": [],\n        \"protocol\": None,\n    }\n\n\ndef test_namespace_read_follows_single_live_cell_and_materializes_heap_results():\n    source_plan = plan()\n    state = apply(\n        initial(),\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    locals_map = dict(state[\"locals\"])\n    locals_map[\"__traced_eval_namespace_0\"] = [\n        \"ref\",\n        \"o15\",\n    ]  # ordinary source binding initialization\n    state[\"locals\"] = [[key, value] for key, value in locals_map.items()]\n    assert validate_state(json.loads(json.dumps(state)), source_plan)\n\n    written = apply(\n        state,\n        source_plan,\n        {\n            \"kind\": \"cell.write\",\n            \"cell\": \"cells.js#value\",\n            \"loweredName\": \"__traced_eval_m1_value\",\n            \"value\": [\"num\", 9],\n        },\n    )\n    read = apply(\n        written,\n        source_plan,\n        {\n            \"kind\": \"namespace.read\",\n            \"namespaceId\": \"o15\",\n            \"exportName\": \"alias\",\n            \"value\": [\"num\", 9],\n        },\n    )\n    keys = apply(\n        read,\n        source_plan,\n        {\n            \"kind\": \"namespace.keys\",\n            \"namespaceId\": \"o15\",\n            \"names\": [\"alias\", \"fixed\", \"value\"],\n            \"resultId\": \"o16\",\n        },\n    )\n    assert dict(keys[\"heap\"])[\"o16\"][\"kind\"] == \"array\"\n    assert dict(keys[\"heap\"])[\"o16\"][\"properties\"] == [\n        [\"length\", [\"num\", 3]],\n        [\"0\", [\"str\", \"alias\"]],\n        [\"1\", [\"str\", \"fixed\"]],\n        [\"2\", [\"str\", \"value\"]],\n    ]\n\n    descriptor = {\n        \"value\": [\"num\", 9],\n        \"writable\": True,\n        \"enumerable\": True,\n        \"configurable\": False,\n    }\n    result = apply(\n        keys,\n        source_plan,\n        {\n            \"kind\": \"namespace.descriptor\",\n            \"namespaceId\": \"o15\",\n            \"exportName\": \"value\",\n            \"value\": descriptor,\n            \"resultId\": \"o17\",\n        },\n    )\n    assert dict(result[\"heap\"])[\"o17\"][\"properties\"] == [\n        [\"value\", [\"num\", 9]],\n        [\"writable\", [\"bool\", True]],\n        [\"enumerable\", [\"bool\", True]],\n        [\"configurable\", [\"bool\", False]],\n    ]\n    assert validate_state(json.loads(json.dumps(result)), source_plan)\n\n\ndef test_tdz_and_immutable_cells_use_source_plan_and_local_presence():\n    source_plan = plan()\n    state = apply(\n        {\"heap\": [], \"locals\": [], \"captureAliases\": [], \"stack\": [], \"protocol\": None},\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    with pytest.raises(ValueError, match=\"TDZ\"):\n        apply(\n            state,\n            source_plan,\n            {\n                \"kind\": \"namespace.read\",\n                \"namespaceId\": \"o15\",\n                \"exportName\": \"value\",\n                \"value\": [\"num\", 1],\n            },\n        )\n    initialized = apply(\n        state,\n        source_plan,\n        {\n            \"kind\": \"cell.initialize\",\n            \"cell\": \"cells.js#value\",\n            \"loweredName\": \"__traced_eval_m1_value\",\n            \"value\": [\"undefined\"],\n        },\n    )\n    read = apply(\n        initialized,\n        source_plan,\n        {\n            \"kind\": \"namespace.read\",\n            \"namespaceId\": \"o15\",\n            \"exportName\": \"alias\",\n            \"value\": [\"undefined\"],\n        },\n    )\n    with pytest.raises(ValueError, match=\"immutable\"):\n        apply(\n            read,\n            source_plan,\n            {\n                \"kind\": \"cell.write\",\n                \"cell\": \"cells.js#fixed\",\n                \"loweredName\": \"__traced_eval_m1_fixed\",\n                \"value\": [\"num\", 3],\n            },\n        )\n\n\ndef test_capture_aliases_share_the_same_export_cell():\n    source_plan = plan()\n    state = initial()\n    state[\"locals\"] = [[\"captured_cell\", [\"num\", 1]], [\"fixed_cell\", [\"num\", 2]]]\n    state[\"captureAliases\"] = [\n        [\"__traced_eval_m1_value\", \"captured_cell\"],\n        [\"__traced_eval_m1_fixed\", \"fixed_cell\"],\n        [\"__traced_eval_namespace_0\", \"namespace_binding\"],\n    ]\n    created = apply(\n        state,\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    locals_map = dict(created[\"locals\"])\n    locals_map[\"namespace_binding\"] = [\"ref\", \"o15\"]\n    created[\"locals\"] = [[key, value] for key, value in locals_map.items()]\n    updated = apply(\n        created,\n        source_plan,\n        {\n            \"kind\": \"cell.write\",\n            \"cell\": \"cells.js#value\",\n            \"loweredName\": \"__traced_eval_m1_value\",\n            \"value\": [\"num\", 8],\n        },\n    )\n    read = apply(\n        updated,\n        source_plan,\n        {\n            \"kind\": \"namespace.read\",\n            \"namespaceId\": \"o15\",\n            \"exportName\": \"value\",\n            \"value\": [\"num\", 8],\n        },\n    )\n    assert dict(read[\"locals\"])[\"captured_cell\"] == [\"num\", 8]\n    assert validate_state(json.loads(json.dumps(read)), source_plan)\n\n\ndef test_namespace_heap_is_source_owned_and_generic_property_path_refuses_it():\n    from megatoken.data.protocol_v8 import ProtocolV8Error, _internal_machine, _node\n\n    source_plan = plan()\n    state = apply(\n        initial(),\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    changed = deepcopy(state)\n    node = dict(dict(changed[\"heap\"])[\"o15\"])\n    node[\"namespaceExportNames\"] = [\"value\", \"alias\", \"fixed\"]\n    changed[\"heap\"] = [[\"o15\", node]]\n    with pytest.raises(ValueError, match=\"source-owned plan\"):\n        validate_state(changed, source_plan)\n    machine = _internal_machine({**state, \"captureAliases\": [], \"frameFunctions\": []})\n    with pytest.raises(ProtocolV8Error, match=\"ordinary object required\"):\n        _node(machine, \"o15\")\n\n\ndef test_namespace_ids_and_result_ids_are_fresh_public_heap_ids():\n    source_plan = plan()\n    state = apply(\n        initial(),\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    with pytest.raises(ValueError, match=\"fresh public heap identity\"):\n        apply(\n            state,\n            source_plan,\n            {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n        )\n    with pytest.raises(ValueError, match=\"fresh public heap identity\"):\n        apply(\n            state,\n            source_plan,\n            {\n                \"kind\": \"namespace.keys\",\n                \"namespaceId\": \"o15\",\n                \"names\": [\"alias\", \"fixed\", \"value\"],\n                \"resultId\": \"obj16\",\n            },\n        )\n\n\ndef test_protocol_lines_apply_namespace_effects_to_shared_machine_and_checkpoint():\n    source_plan = plan()\n    state = initial()\n    state[\"stack\"] = [\"invocation-1\"]\n    create = {\n        \"kind\": \"namespace.create\",\n        \"namespaceId\": \"o15\",\n        \"moduleFile\": \"cells.js\",\n    }\n    state = apply_protocol_to_shared_state(\n        state, encode_protocol_record(create), namespace_plan=source_plan\n    )\n    assert state[\"protocol\"][\"sequence\"] == 1\n    state = json.loads(json.dumps(state))\n    write = {\n        \"kind\": \"cell.write\",\n        \"cell\": \"cells.js#value\",\n        \"loweredName\": \"__traced_eval_m1_value\",\n        \"value\": [\"num\", 9],\n    }\n    state = apply_protocol_to_shared_state(\n        state, encode_protocol_record(write), namespace_plan=source_plan\n    )\n    state = apply_protocol_to_shared_state(\n        state,\n        encode_protocol_record(\n            {\n                \"kind\": \"namespace.read\",\n                \"namespaceId\": \"o15\",\n                \"exportName\": \"alias\",\n                \"value\": [\"num\", 9],\n            }\n        ),\n        namespace_plan=source_plan,\n    )\n    state = apply_protocol_to_shared_state(\n        state,\n        encode_protocol_record(\n            {\n                \"kind\": \"namespace.keys\",\n                \"namespaceId\": \"o15\",\n                \"names\": [\"alias\", \"fixed\", \"value\"],\n                \"resultId\": \"o16\",\n            }\n        ),\n        namespace_plan=source_plan,\n    )\n    descriptor = {\n        \"kind\": \"namespace.descriptor\",\n        \"namespaceId\": \"o15\",\n        \"exportName\": \"value\",\n        \"value\": {\n            \"value\": [\"num\", 9],\n            \"writable\": True,\n            \"enumerable\": True,\n            \"configurable\": False,\n        },\n        \"resultId\": \"o17\",\n    }\n    state = apply_protocol_to_shared_state(\n        state, encode_protocol_record(descriptor), namespace_plan=source_plan\n    )\n    assert state[\"protocol\"][\"sequence\"] == 5\n    assert dict(state[\"heap\"])[\"o16\"][\"kind\"] == \"array\"\n    assert dict(state[\"heap\"])[\"o17\"][\"kind\"] == \"object\"\n    with pytest.raises(ValueError, match=\"source-derived namespace plan\"):\n        apply_protocol_to_shared_state(\n            state,\n            encode_protocol_record(create),\n        )\n\n\ndef test_protocol_namespace_descriptor_validates_before_shared_heap_allocation():\n    source_plan = plan()\n    state = initial()\n    state[\"stack\"] = [\"invocation-1\"]\n    state = apply_protocol_to_shared_state(\n        state,\n        encode_protocol_record(\n            {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"}\n        ),\n        namespace_plan=source_plan,\n    )\n    bad = {\n        \"kind\": \"namespace.descriptor\",\n        \"namespaceId\": \"o15\",\n        \"exportName\": \"value\",\n        \"value\": {\n            \"value\": [\"num\", 1],\n            \"writable\": False,\n            \"enumerable\": True,\n            \"configurable\": False,\n        },\n        \"resultId\": \"o16\",\n    }\n    with pytest.raises(ValueError):\n        encode_protocol_record(bad)\n\n\ndef test_object_keys_reads_every_export_and_refuses_tdz():\n    source_plan = plan()\n    state = {\n        \"heap\": [],\n        \"locals\": [],\n        \"captureAliases\": [],\n        \"frameFunctions\": [],\n        \"stack\": [],\n        \"protocol\": None,\n    }\n    state[\"stack\"] = [\"invocation-1\"]\n    state = apply_protocol_to_shared_state(\n        state,\n        encode_protocol_record(\n            {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"}\n        ),\n        namespace_plan=source_plan,\n    )\n    with pytest.raises(ValueError, match=\"TDZ Object.keys\"):\n        apply_protocol_to_shared_state(\n            state,\n            encode_protocol_record(\n                {\n                    \"kind\": \"namespace.keys\",\n                    \"namespaceId\": \"o15\",\n                    \"names\": [\"alias\", \"fixed\", \"value\"],\n                    \"resultId\": \"o16\",\n                }\n            ),\n            namespace_plan=source_plan,\n        )\n\n\ndef test_generic_bind_cannot_bypass_namespace_owner_or_cell_lifecycle():\n    source_plan = plan()\n    state = initial()\n    state[\"stack\"] = [\"invocation-1\"]\n    state = apply_protocol_to_shared_state(\n        state,\n        encode_protocol_record(\n            {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"}\n        ),\n        namespace_plan=source_plan,\n    )\n    for name, value in [\n        (\"__traced_eval_namespace_0\", [\"null\"]),\n        (\"__traced_eval_m1_value\", [\"num\", 5]),\n    ]:\n        with pytest.raises(ValueError, match=\"lifecycle records\"):\n            apply_protocol_to_shared_state(\n                state,\n                encode_protocol_record({\"kind\": \"bind\", \"name\": name, \"value\": value}),\n                namespace_plan=source_plan,\n            )\n\n\ndef test_namespace_operation_cannot_bypass_pending_number_continuation_guard():\n    from megatoken.data.number_v8 import SCHEMA as NUMBER_SCHEMA\n    from megatoken.data.protocol_v8 import create_protocol_state\n\n    source_plan = plan()\n    state = initial()\n    state[\"stack\"] = [\"invocation-1\"]\n    state[\"frameFunctions\"] = [[\"invocation-1\", \"code-1\"]]\n    state[\"heap\"] = [\n        [\n            \"o20\",\n            {\n                \"id\": \"o20\",\n                \"kind\": \"object\",\n                \"prototype\": None,\n                \"extensible\": True,\n                \"properties\": [],\n            },\n        ]\n    ]\n    protocol = create_protocol_state()\n    protocol[\"numberConversions\"] = {\n        \"schema\": NUMBER_SCHEMA,\n        \"operations\": [\n            {\n                \"id\": \"conversion-1\",\n                \"parent\": \"invocation-1\",\n                \"input\": [\"ref\", \"o20\"],\n                \"index\": -1,\n                \"method\": None,\n                \"builtin\": None,\n                \"child\": None,\n                \"phase\": \"select\",\n                \"primitive\": None,\n                \"result\": None,\n            }\n        ],\n    }\n    state[\"protocol\"] = protocol\n    with pytest.raises(ValueError, match=\"pending continuation requires number.select\"):\n        apply_protocol_to_shared_state(\n            state,\n            encode_protocol_record(\n                {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"}\n            ),\n            namespace_plan=source_plan,\n        )\n\n\ndef test_detailed_bind_cannot_overwrite_namespace_cell_or_owner():\n    from megatoken.data.protocol_v8 import ProtocolV8Error, assert_detailed_record_compatible\n\n    source_plan = plan()\n    state = apply(\n        initial(),\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    with pytest.raises(ProtocolV8Error, match=\"bypasses lifecycle\"):\n        assert_detailed_record_compatible(\n            state,\n            \"bind\",\n            {\"name\": \"__traced_eval_m1_value\", \"value\": [\"num\", 5]},\n            namespace_plan=source_plan,\n        )\n\n\ndef test_compact_region_cannot_write_namespace_backed_cell():\n    from megatoken.data.native_v8 import NativeV8Error, _replay_region\n    from megatoken.data.semantic_json import stable_algorithm_hash\n\n    source_plan = plan()\n    state = initial()\n    region = {\n        \"id\": \"r1\",\n        \"digest\": \"region-digest\",\n        \"completion\": \"normal\",\n        \"operations\": [\n            {\n                \"kind\": \"bind\",\n                \"binding\": \"__traced_eval_m1_value\",\n                \"term\": {\"op\": \"literal\", \"value\": [\"num\", 5]},\n            }\n        ],\n    }\n    program = {\"definitionDigest\": \"definition-digest\", \"regions\": [region]}\n    context = {\"state\": state, \"visibleThrough\": 1}\n    entry = {\n        \"definition\": \"definition-digest\",\n        \"region\": \"r1\",\n        \"regionDigest\": \"region-digest\",\n        \"visibleThrough\": 1,\n        \"stateDigest\": stable_algorithm_hash(state),\n    }\n    target = 'region {\"region\":\"r1\",\"bindings\":[],\"decisions\":[],\"completion\":{\"kind\":\"normal\"}}'\n    with pytest.raises(NativeV8Error, match=\"Compact regions are unsupported\"):\n        _replay_region(program, context, target, entry, namespace_plan=source_plan)\n\n\ndef test_generic_protocol_outputs_cannot_mutate_cells_or_rebind_aliases():\n    source_plan = plan()\n    before = apply(\n        initial(),\n        source_plan,\n        {\"kind\": \"namespace.create\", \"namespaceId\": \"o15\", \"moduleFile\": \"cells.js\"},\n    )\n    mutated = deepcopy(before)\n    local_values = dict(mutated[\"locals\"])\n    local_values[\"__traced_eval_m1_value\"] = [\"num\", 10]\n    mutated[\"locals\"] = [[key, value] for key, value in local_values.items()]\n    with pytest.raises(ValueError, match=\"changed a live namespace owner or source cell\"):\n        assert_experimental_module_namespace_state_unchanged(before, mutated, source_plan)\n\n    remapped = deepcopy(before)\n    remapped[\"captureAliases\"] = [[\"__traced_eval_m1_value\", \"other_cell\"]]\n    with pytest.raises(ValueError, match=\"changed a protected capture alias\"):\n        assert_experimental_module_namespace_state_unchanged(before, remapped, source_plan)\n"}
2026-11-22T07:31:55.2212336Z FORMATTED_SOURCE_JSON {"path": "src/megatoken/data/protocol_v8.py", "content": "\"\"\"Independent decoder and validator for semantic-protocol-record/1.\n\nThis protocol extends only the v8 shared machine. The older detailed and pure\nalgorithm languages keep their narrower tagged-value domains.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport math\n\nfrom . import semantic_primitives as primitives\nfrom .construction_v8 import FIELDS as CONSTRUCTION_FIELDS\nfrom .construction_v8 import apply_record as apply_construction_record\nfrom .construction_v8 import assert_next as assert_construction_next\nfrom .construction_v8 import validate_record as validate_construction_record\nfrom .construction_v8 import validate_state as validate_construction_record_state\nfrom .enumeration_v8 import FIELDS as ENUMERATION_FIELDS\nfrom .enumeration_v8 import apply_record as apply_enumeration_record\nfrom .enumeration_v8 import validate_record as validate_enumeration_record\nfrom .enumeration_v8 import validate_state as validate_enumeration_state\nfrom .generator_v8 import FIELDS as GENERATOR_FIELDS\nfrom .generator_v8 import apply_record as apply_generator_record\nfrom .generator_v8 import assert_next as assert_generator_next\nfrom .generator_v8 import validate_record as validate_generator_record\nfrom .generator_v8 import validate_state as validate_generator_state\nfrom .iterator_v8 import FIELDS as ITERATOR_FIELDS\nfrom .iterator_v8 import apply_record as apply_iterator_record\nfrom .iterator_v8 import validate_record as validate_iterator_record\nfrom .iterator_v8 import validate_state as validate_iterator_state\nfrom .memory_v8 import FIELDS as MEMORY_FIELDS\nfrom .memory_v8 import apply_record as apply_memory_record\nfrom .memory_v8 import validate_record as validate_memory_record\nfrom .memory_v8 import validate_state as validate_memory_state\nfrom .number_v8 import FIELDS as NUMBER_FIELDS\nfrom .number_v8 import apply_record as apply_number_record\nfrom .number_v8 import assert_next as assert_number_next\nfrom .number_v8 import validate_record as validate_number_record\nfrom .number_v8 import validate_state as validate_number_state\nfrom .primitive_conversion_v8 import FIELDS as PRIMITIVE_CONVERSION_FIELDS\nfrom .primitive_conversion_v8 import apply_record as apply_primitive_conversion_record\nfrom .primitive_conversion_v8 import assert_next as assert_primitive_conversion_next\nfrom .primitive_conversion_v8 import validate_record as validate_primitive_conversion_record\nfrom .primitive_conversion_v8 import validate_state as validate_primitive_conversion_state\nfrom .promise_executor_v8 import FIELDS as PROMISE_EXECUTOR_FIELDS\nfrom .promise_executor_v8 import apply_record as apply_promise_executor_record\nfrom .promise_executor_v8 import assert_callable as assert_promise_executor_callable\nfrom .promise_executor_v8 import assert_next as assert_promise_executor_next\nfrom .promise_executor_v8 import validate_record as validate_promise_executor_record\nfrom .promise_join_v8 import FIELDS as PROMISE_JOIN_FIELDS\nfrom .promise_join_v8 import apply_record as apply_promise_join_record\nfrom .promise_join_v8 import assert_next as assert_promise_join_next\nfrom .promise_join_v8 import validate_record as validate_promise_join_record\nfrom .proxy_v8 import FIELDS as PROXY_FIELDS\nfrom .proxy_v8 import apply_record as apply_proxy_record\nfrom .proxy_v8 import assert_next as assert_proxy_next\nfrom .proxy_v8 import validate_record as validate_proxy_record\nfrom .proxy_v8 import validate_state as validate_proxy_state\nfrom .semantic_json import stable_algorithm_json\n\nPREFIX = \"protocol \"\nNAMESPACE_RECORD_KINDS = {\n    \"cell.initialize\",\n    \"cell.write\",\n    \"namespace.create\",\n    \"namespace.keys\",\n    \"namespace.read\",\n    \"namespace.descriptor\",\n}\nSCHEMA = \"semantic-protocol-record/1\"\nSTATE_SCHEMA = \"semantic-protocol-state/1\"\nWELL_KNOWN = (\n    \"iterator\",\n    \"asyncIterator\",\n    \"toPrimitive\",\n    \"hasInstance\",\n    \"species\",\n    \"isConcatSpreadable\",\n    \"match\",\n    \"matchAll\",\n    \"replace\",\n    \"search\",\n    \"split\",\n    \"toStringTag\",\n    \"unscopables\",\n)\nFIELDS = {\n    \"symbol.create\": {\"kind\", \"id\", \"description\"},\n    \"symbol.for\": {\"kind\", \"id\", \"key\"},\n    \"symbol.read\": {\"kind\", \"symbol\", \"operation\", \"result\", \"bind\"},\n    \"allocate\": {\n        \"kind\",\n        \"name\",\n        \"objectKind\",\n        \"length\",\n        \"properties\",\n        \"code\",\n        \"captures\",\n        \"functionKind\",\n        \"lexicalReceiver\",\n    },\n    \"bind\": {\"kind\", \"name\", \"value\"},\n    \"cell.initialize\": {\"kind\", \"cell\", \"loweredName\", \"value\"},\n    \"cell.write\": {\"kind\", \"cell\", \"loweredName\", \"value\"},\n    \"namespace.create\": {\"kind\", \"namespaceId\", \"moduleFile\"},\n    \"namespace.keys\": {\"kind\", \"namespaceId\", \"names\", \"resultId\"},\n    \"namespace.read\": {\"kind\", \"namespaceId\", \"exportName\", \"value\"},\n    \"namespace.descriptor\": {\"kind\", \"namespaceId\", \"exportName\", \"value\", \"resultId\"},\n    \"compute\": {\"kind\", \"expr\", \"result\", \"bind\"},\n    \"choose\": {\"kind\", \"expr\", \"decision\", \"path\"},\n    \"call\": {\"kind\", \"child\", \"callee\", \"receiver\", \"arguments\"},\n    \"return\": {\"kind\", \"value\", \"invocation\"},\n    \"throw\": {\"kind\", \"value\", \"invocation\"},\n    \"end\": {\"kind\", \"completion\"},\n    \"property.define\": {\"kind\", \"object\", \"key\", \"descriptor\", \"success\"},\n    \"property.get\": {\"kind\", \"object\", \"key\", \"receiver\", \"result\"},\n    \"property.hasOwn\": {\"kind\", \"object\", \"key\", \"result\"},\n    \"property.set\": {\"kind\", \"object\", \"key\", \"receiver\", \"value\", \"success\"},\n    \"property.delete\": {\"kind\", \"object\", \"key\", \"success\"},\n    \"property.keys\": {\"kind\", \"object\", \"mode\", \"name\", \"keys\"},\n    \"property.prototype\": {\"kind\", \"object\", \"prototype\", \"success\"},\n    \"property.preventExtensions\": {\"kind\", \"object\"},\n    \"property.get.call\": {\"kind\", \"id\", \"child\", \"object\", \"key\", \"receiver\"},\n    \"property.set.call\": {\"kind\", \"id\", \"child\", \"object\", \"key\", \"receiver\", \"value\"},\n    \"property.finish\": {\"kind\", \"id\", \"completion\"},\n}\n\n\nclass ProtocolV8Error(ValueError):\n    pass\n\n\nFIELDS.update(CONSTRUCTION_FIELDS)\nFIELDS.update(MEMORY_FIELDS)\nFIELDS.update(ITERATOR_FIELDS)\nFIELDS.update(ENUMERATION_FIELDS)\nFIELDS.update(PROMISE_JOIN_FIELDS)\nFIELDS.update(PROMISE_EXECUTOR_FIELDS)\nFIELDS.update(NUMBER_FIELDS)\nFIELDS.update(PRIMITIVE_CONVERSION_FIELDS)\nFIELDS.update(GENERATOR_FIELDS)\nFIELDS.update(PROXY_FIELDS)\n\n\ndef _fail(message):\n    raise ProtocolV8Error(f\"Invalid {SCHEMA}: {message}\")\n\n\ndef _exact(value, fields, label):\n    if type(value) is not dict or set(value) != set(fields):\n        _fail(label + \" fields\")\n\n\ndef _identity(value):\n    if not isinstance(value, str) or not value or len(value) > 256:\n        _fail(\"identity\")\n\n\ndef validate_protocol_value(value):\n    if isinstance(value, list) and value and value[0] == \"symbol\":\n        if len(value) != 2:\n            _fail(\"symbol value\")\n        _identity(value[1])\n        return True\n    primitives._validate_value(value)\n    return True\n\n\ndef validate_protocol_key(key):\n    if (\n        not isinstance(key, list)\n        or len(key) != 2\n        or key[0] not in (\"str\", \"symbol\")\n        or not isinstance(key[1], str)\n    ):\n        _fail(\"tagged property key\")\n    if key[0] == \"symbol\":\n        _identity(key[1])\n    return True\n\n\ndef _validate_descriptor(value):\n    if not isinstance(value, dict):\n        _fail(\"descriptor\")\n    if value.get(\"kind\") == \"data\":\n        _exact(\n            value, {\"kind\", \"value\", \"writable\", \"enumerable\", \"configurable\"}, \"data descriptor\"\n        )\n        validate_protocol_value(value[\"value\"])\n        if type(value[\"writable\"]) is not bool:\n            _fail(\"descriptor boolean\")\n    elif value.get(\"kind\") == \"accessor\":\n        _exact(value, {\"kind\", \"get\", \"set\", \"enumerable\", \"configurable\"}, \"accessor descriptor\")\n        for field in (\"get\", \"set\"):\n            validate_protocol_value(value[field])\n            if value[field][0] not in (\"ref\", \"undefined\"):\n                _fail(\"accessor closure or undefined\")\n    else:\n        _fail(\"descriptor kind\")\n    if type(value[\"enumerable\"]) is not bool or type(value[\"configurable\"]) is not bool:\n        _fail(\"descriptor boolean\")\n\n\ndef _expression(term, depth=0, budget=None):\n    if budget is None:\n        budget = [128]\n    budget[0] -= 1\n    if budget[0] < 0 or depth > 16:\n        _fail(\"expression bound\")\n    op = term.get(\"op\") if type(term) is dict else None\n    if op == \"literal\":\n        _exact(term, {\"op\", \"value\"}, \"literal\")\n        validate_protocol_value(term[\"value\"])\n    elif op == \"local\":\n        _exact(term, {\"op\", \"name\"}, \"local\")\n        _identity(term[\"name\"])\n    elif op == \"unary\":\n        _exact(term, {\"op\", \"operator\", \"arg\"}, \"unary\")\n        if term[\"operator\"] not in (\"!\", \"+\", \"-\", \"~\", \"typeof\", \"void\"):\n            _fail(\"unary operator\")\n        _expression(term[\"arg\"], depth + 1, budget)\n    elif op == \"logical-test\":\n        _exact(term, {\"op\", \"operator\", \"arg\"}, \"logical test\")\n        if term[\"operator\"] not in (\"&&\", \"||\", \"??\"):\n            _fail(\"logical operator\")\n        _expression(term[\"arg\"], depth + 1, budget)\n    elif op == \"binary\":\n        _exact(term, {\"op\", \"operator\", \"left\", \"right\"}, \"binary\")\n        if term[\"operator\"] not in (\n            \"+\",\n            \"-\",\n            \"*\",\n            \"/\",\n            \"%\",\n            \"**\",\n            \"<\",\n            \"<=\",\n            \">\",\n            \">=\",\n            \"===\",\n            \"!==\",\n            \"==\",\n            \"!=\",\n            \"&\",\n            \"|\",\n            \"^\",\n            \"<<\",\n            \">>\",\n            \">>>\",\n        ):\n            _fail(\"binary operator\")\n        _expression(term[\"left\"], depth + 1, budget)\n        _expression(term[\"right\"], depth + 1, budget)\n    else:\n        _fail(\"expression requires explicit boundary\")\n\n\ndef validate_protocol_record(record):\n    if type(record) is not dict or not isinstance(record.get(\"kind\"), str):\n        _fail(\"record kind must be a string\")\n    if record[\"kind\"] in ENUMERATION_FIELDS:\n        return validate_enumeration_record(record)\n    if record[\"kind\"] in PROMISE_EXECUTOR_FIELDS:\n        return validate_promise_executor_record(record)\n    if type(record) is dict and record.get(\"kind\") in PROXY_FIELDS:\n        return validate_proxy_record(record)\n    if type(record) is dict and record.get(\"kind\") in NUMBER_FIELDS:\n        return validate_number_record(record)\n    if record[\"kind\"] in PRIMITIVE_CONVERSION_FIELDS:\n        return validate_primitive_conversion_record(record)\n    if type(record) is dict and record.get(\"kind\") in GENERATOR_FIELDS:\n        return validate_generator_record(record)\n    if type(record) is dict and record.get(\"kind\") in PROMISE_JOIN_FIELDS:\n        try:\n            validate_promise_join_record(record)\n        except ProtocolV8Error:\n            raise\n        except (TypeError, KeyError, IndexError) as error:\n            raise ProtocolV8Error(\"Invalid Promise join record\") from error\n        return True\n    if type(record) is dict and record.get(\"kind\") in CONSTRUCTION_FIELDS:\n        try:\n            validate_construction_record(record)\n        except ProtocolV8Error:\n            raise\n        except (TypeError, KeyError, IndexError) as error:\n            raise ProtocolV8Error(\"Invalid construction record\") from error\n        return True\n    if type(record) is dict and record.get(\"kind\") in MEMORY_FIELDS:\n        try:\n            validate_memory_record(record)\n        except ProtocolV8Error:\n            raise\n        except (TypeError, KeyError, IndexError) as error:\n            raise ProtocolV8Error(\"Invalid binary-memory record\") from error\n        return True\n    if type(record) is dict and record.get(\"kind\") in ITERATOR_FIELDS:\n        try:\n            validate_iterator_record(record)\n        except ProtocolV8Error:\n            raise\n        except (TypeError, KeyError, IndexError) as error:\n            raise ProtocolV8Error(\"Invalid iterator record\") from error\n        return True\n    if type(record) is not dict or record.get(\"kind\") not in FIELDS:\n        _fail(\"record kind\")\n    _exact(record, FIELDS[record[\"kind\"]], \"record\")\n    for key in (\"id\", \"name\", \"object\", \"child\", \"invocation\", \"namespaceId\", \"resultId\"):\n        if key in record:\n            _identity(record[key])\n    if \"bind\" in record and record[\"bind\"] is not None:\n        _identity(record[\"bind\"])\n    for key in (\"value\", \"result\", \"decision\", \"receiver\", \"callee\", \"symbol\"):\n        if key in record and not (record[\"kind\"] == \"namespace.descriptor\" and key == \"value\"):\n            validate_protocol_value(record[key])\n    if \"success\" in record and type(record[\"success\"]) is not bool:\n        _fail(\"success boolean\")\n    if \"expr\" in record:\n        _expression(record[\"expr\"])\n    if record[\"kind\"].startswith(\"property.\") and \"key\" in record:\n        validate_protocol_key(record[\"key\"])\n    kind = record[\"kind\"]\n    if kind in (\"cell.initialize\", \"cell.write\"):\n        _identity(record[\"cell\"])\n        _identity(record[\"loweredName\"])\n        validate_protocol_value(record[\"value\"])\n    elif kind == \"namespace.create\":\n        if not isinstance(record[\"moduleFile\"], str):\n            _fail(\"namespace module file\")\n    elif kind == \"namespace.keys\":\n        if not isinstance(record[\"names\"], list) or any(\n            not isinstance(name, str) for name in record[\"names\"]\n        ):\n            _fail(\"namespace key list\")\n    elif kind == \"namespace.read\":\n        if not isinstance(record[\"exportName\"], str):\n            _fail(\"namespace export name\")\n        validate_protocol_value(record[\"value\"])\n    elif kind == \"namespace.descriptor\":\n        if not isinstance(record[\"exportName\"], str) or type(record[\"value\"]) is not dict:\n            _fail(\"namespace descriptor\")\n        descriptor = record[\"value\"]\n        _exact(\n            descriptor, {\"value\", \"writable\", \"enumerable\", \"configurable\"}, \"namespace descriptor\"\n        )\n        validate_protocol_value(descriptor[\"value\"])\n        if (\n            type(descriptor[\"writable\"]) is not bool\n            or type(descriptor[\"enumerable\"]) is not bool\n            or type(descriptor[\"configurable\"]) is not bool\n            or descriptor[\"writable\"] is not True\n            or descriptor[\"enumerable\"] is not True\n            or descriptor[\"configurable\"] is not False\n        ):\n            _fail(\"namespace descriptor flags\")\n    elif kind == \"symbol.create\":\n        validate_protocol_value(record[\"description\"])\n        if record[\"description\"][0] not in (\"str\", \"undefined\"):\n            _fail(\"symbol description\")\n    elif kind == \"symbol.for\":\n        if not isinstance(record[\"key\"], str):\n            _fail(\"registry key\")\n    elif kind == \"symbol.read\":\n        if record[\"symbol\"][0] != \"symbol\" or record[\"operation\"] not in (\n            \"description\",\n            \"keyFor\",\n            \"toString\",\n        ):\n            _fail(\"symbol read operation\")\n    elif kind == \"allocate\":\n        if record[\"objectKind\"] not in (\"object\", \"array\", \"closure\"):\n            _fail(\"allocation kind\")\n        if record[\"objectKind\"] == \"array\":\n            if type(record[\"length\"]) is not int or not 0 <= record[\"length\"] <= 4096:\n                _fail(\"array length\")\n        elif record[\"length\"] is not None:\n            _fail(\"non-array length\")\n        if (\n            not isinstance(record[\"properties\"], list)\n            or len(record[\"properties\"]) + (record[\"objectKind\"] == \"array\") > 4096\n        ):\n            _fail(\"allocation properties\")\n        for item in record[\"properties\"]:\n            _exact(item, {\"key\", \"value\"}, \"property\")\n            validate_protocol_key(item[\"key\"])\n            validate_protocol_value(item[\"value\"])\n        if not isinstance(record[\"captures\"], list) or len(record[\"captures\"]) > 4096:\n            _fail(\"captures\")\n        for capture in record[\"captures\"]:\n            _exact(capture, {\"binding\", \"cell\"}, \"capture\")\n            _identity(capture[\"binding\"])\n            _identity(capture[\"cell\"])\n        if record[\"objectKind\"] == \"closure\":\n            _identity(record[\"code\"])\n            if record[\"functionKind\"] not in (\"ordinary\", \"arrow\"):\n                _fail(\"closure function kind\")\n            if record[\"functionKind\"] == \"arrow\":\n                validate_protocol_value(record[\"lexicalReceiver\"])\n            elif record[\"lexicalReceiver\"] is not None:\n                _fail(\"ordinary closure lexical receiver\")\n        elif (\n            record[\"code\"] is not None\n            or record[\"captures\"]\n            or record[\"functionKind\"] is not None\n            or record[\"lexicalReceiver\"] is not None\n        ):\n            _fail(\"non-closure code or captures\")\n    elif kind == \"call\":\n        if (\n            record[\"callee\"][0] != \"ref\"\n            or not isinstance(record[\"arguments\"], list)\n            or len(record[\"arguments\"]) > 4096\n        ):\n            _fail(\"call shape\")\n        for arg in record[\"arguments\"]:\n            validate_protocol_value(arg)\n    elif kind == \"choose\" and record[\"path\"] not in (\"then\", \"else\", \"evaluate-right\", \"use-left\"):\n        _fail(\"choice path\")\n    elif kind == \"property.define\":\n        _validate_descriptor(record[\"descriptor\"])\n    elif kind == \"property.hasOwn\" and record[\"result\"][0] != \"bool\":\n        _fail(\"own property result boolean\")\n    elif kind == \"property.keys\":\n        if record[\"mode\"] not in (\n            \"own\",\n            \"strings\",\n            \"symbols\",\n            \"enumerable-strings\",\n        ) or not isinstance(record[\"keys\"], list):\n            _fail(\"key enumeration\")\n        for key in record[\"keys\"]:\n            validate_protocol_key(key)\n    elif kind == \"property.prototype\":\n        proto = record[\"prototype\"]\n        if proto is not None and proto != \"ordinary\":\n            validate_protocol_value(proto)\n            if proto[0] != \"ref\":\n                _fail(\"prototype\")\n    elif kind == \"property.finish\":\n        completion = record[\"completion\"]\n        _exact(completion, {\"kind\", \"value\"}, \"completion\")\n        if completion[\"kind\"] not in (\"normal\", \"throw\"):\n            _fail(\"completion kind\")\n        validate_protocol_value(completion[\"value\"])\n    elif kind == \"end\" and record[\"completion\"] not in (\"return\", \"throw\"):\n        _fail(\"terminal completion\")\n    return True\n\n\ndef encode_protocol_record(record):\n    validate_protocol_record(record)\n    return PREFIX + stable_algorithm_json(record)\n\n\ndef decode_protocol_record(line):\n    if (\n        not isinstance(line, str)\n        or not line.startswith(PREFIX)\n        or len(line.encode(\"utf-8\")) > 65536\n    ):\n        _fail(\"canonical line\")\n    try:\n        record = json.loads(line[len(PREFIX) :])\n    except (TypeError, json.JSONDecodeError) as error:\n        raise ProtocolV8Error(\"Invalid protocol record JSON\") from error\n    validate_protocol_record(record)\n    if encode_protocol_record(record) != line:\n        _fail(\"noncanonical bytes\")\n    return record\n\n\ndef create_protocol_state():\n    return {\n        \"schema\": STATE_SCHEMA,\n        \"symbols\": [\n            {\"id\": \"well-known:\" + name, \"kind\": \"well-known\", \"name\": name} for name in WELL_KNOWN\n        ],\n        \"pendingCalls\": [],\n        \"callFrames\": [],\n        \"sequence\": 0,\n        \"construction\": None,\n        \"numberConversions\": None,\n        \"primitiveConversions\": None,\n        \"proxyCalls\": None,\n        \"promiseExecutors\": None,\n    }\n\n\ndef _key(tag):\n    return tag[1] if tag[0] == \"str\" else (\"symbol\", tag[1])\n\n\ndef _public(key):\n    return [\"symbol\", key[1]] if isinstance(key, tuple) else [\"str\", key]\n\n\ndef _symbol(machine, identity):\n    row = next((row for row in machine[\"protocol\"][\"symbols\"] if row[\"id\"] == identity), None)\n    if row is None:\n        _fail(\"undeclared Symbol identity\")\n    return row\n\n\ndef _known(machine, value, self_id=None):\n    validate_protocol_value(value)\n    if value[0] == \"symbol\":\n        _symbol(machine, value[1])\n    if value[0] == \"ref\" and value[1] != self_id and value[1] not in machine[\"heap\"]:\n        _fail(\"unallocated reference\")\n    return value\n\n\ndef _assert_fresh_heap_identity(machine, identity):\n    _identity(identity)\n    protocol = machine.get(\"protocol\") or {}\n    heap = machine[\"heap\"]\n    heap_ids = set(heap) if isinstance(heap, dict) else {row[0] for row in heap}\n    reserved = {row[\"id\"] for row in protocol.get(\"symbols\", [])}\n    reserved.update(\n        row[\"id\"] for row in (protocol.get(\"construction\") or {}).get(\"privateNames\", [])\n    )\n    if identity in heap_ids or identity in reserved:\n        _fail(\"duplicate or reserved heap identity\")\n\n\ndef _node(machine, identity):\n    node = machine[\"heap\"].get(identity)\n    if not isinstance(node, dict) or node.get(\"kind\") not in (\n        \"object\",\n        \"array\",\n        \"closure\",\n        \"generator\",\n    ):\n        _fail(\"ordinary object required\")\n    node.setdefault(\"properties\", {})\n    return node\n\n\ndef _descriptor(node, key):\n    metadata = node.get(\"descriptors\", {}).get(key)\n    if metadata and metadata.get(\"kind\") == \"accessor\":\n        return copy.deepcopy(metadata)\n    if key not in node[\"properties\"]:\n        return None\n    default = {\"kind\": \"data\", \"writable\": True, \"enumerable\": True, \"configurable\": True}\n    if node[\"kind\"] == \"array\" and key == \"length\":\n        default = {\"kind\": \"data\", \"writable\": True, \"enumerable\": False, \"configurable\": False}\n    return {\n        **default,\n        **copy.deepcopy(metadata or {}),\n        \"value\": copy.deepcopy(node[\"properties\"][key]),\n    }\n\n\n_OBJECT_INTRINSIC_NAMES = {\n    \"constructor\",\n    \"__proto__\",\n    \"toString\",\n    \"toLocaleString\",\n    \"valueOf\",\n    \"hasOwnProperty\",\n    \"isPrototypeOf\",\n    \"propertyIsEnumerable\",\n    \"__defineGetter__\",\n    \"__defineSetter__\",\n    \"__lookupGetter__\",\n    \"__lookupSetter__\",\n}\n_ARRAY_INTRINSIC_NAMES = {\n    \"at\",\n    \"concat\",\n    \"copyWithin\",\n    \"entries\",\n    \"every\",\n    \"fill\",\n    \"filter\",\n    \"find\",\n    \"findIndex\",\n    \"findLast\",\n    \"findLastIndex\",\n    \"flat\",\n    \"flatMap\",\n    \"forEach\",\n    \"includes\",\n    \"indexOf\",\n    \"join\",\n    \"keys\",\n    \"lastIndexOf\",\n    \"map\",\n    \"pop\",\n    \"push\",\n    \"reduce\",\n    \"reduceRight\",\n    \"reverse\",\n    \"shift\",\n    \"slice\",\n    \"some\",\n    \"sort\",\n    \"splice\",\n    \"toReversed\",\n    \"toSorted\",\n    \"toSpliced\",\n    \"unshift\",\n    \"values\",\n    \"with\",\n}\n\n\ndef _missing_intrinsic(node, key):\n    if isinstance(key, tuple):\n        return (\n            node[\"kind\"] == \"array\"\n            and key[1] in (\"well-known:iterator\", \"well-known:unscopables\")\n            or node[\"kind\"] == \"closure\"\n            and key[1] == \"well-known:hasInstance\"\n        )\n    return (\n        key in _OBJECT_INTRINSIC_NAMES\n        or node[\"kind\"] == \"array\"\n        and key in _ARRAY_INTRINSIC_NAMES\n        or node[\"kind\"] == \"closure\"\n        and key in (\"call\", \"apply\", \"bind\", \"length\", \"name\", \"prototype\", \"arguments\", \"caller\")\n    )\n\n\ndef _lookup_descriptor(machine, identity, key, *, for_set=False):\n    \"\"\"Find an own or inherited descriptor and its owning object.\"\"\"\n    seen = set()\n    while identity is not None:\n        if identity in seen:\n            _fail(\"prototype cycle\")\n        seen.add(identity)\n        node = _node(machine, identity)\n        descriptor = _descriptor(node, key)\n        if descriptor is not None:\n            return node, descriptor\n        prototype = node.get(\"prototype\", \"ordinary\")\n        if prototype == \"ordinary\":\n            if for_set and (\n                isinstance(key, str)\n                and key != \"__proto__\"\n                and key in _OBJECT_INTRINSIC_NAMES\n                or node[\"kind\"] == \"array\"\n                and key == (\"symbol\", \"well-known:iterator\")\n            ):\n                return None, {\"kind\": \"data\", \"writable\": True}\n            if _missing_intrinsic(node, key):\n                _fail(\"inherited intrinsic property requires its callable protocol\")\n            return None, None\n        from .generator_v8 import INTRINSICS as GENERATOR_INTRINSICS\n        from .generator_v8 import _lookup as generator_lookup\n\n        if isinstance(prototype, str) and prototype in GENERATOR_INTRINSICS:\n            selected = generator_lookup(machine, [\"ref\", identity], _public(key))\n            if \"descriptor\" not in selected:\n                _fail(\"intrinsic property requires its declared protocol\")\n            return None, selected[\"descriptor\"]\n        identity = prototype[1] if isinstance(prototype, list) and prototype[0] == \"ref\" else None\n    return None, None\n\n\ndef _install(node, key, d):\n    exists = _descriptor(node, key) is not None\n    if not exists:\n        if len(set(node[\"properties\"]) | set(node.get(\"descriptors\", {}))) >= 4096:\n            _fail(\"own property bound\")\n    if \"keyOrder\" not in node:\n        node[\"keyOrder\"] = _ordered(node)\n    node.setdefault(\"descriptors\", {})\n    node.setdefault(\"extensible\", True)\n    if not exists:\n        node[\"keyOrder\"].append(key)\n    else:\n        # The producer serializes its Map-backed properties and descriptors in\n        # insertion order. Its descriptor installation deletes and reinserts\n        # an existing key while preserving the separate public keyOrder list.\n        node[\"properties\"].pop(key, None)\n        node[\"descriptors\"].pop(key, None)\n    if d[\"kind\"] == \"data\":\n        node[\"properties\"][key] = copy.deepcopy(d[\"value\"])\n        node[\"descriptors\"][key] = {k: copy.deepcopy(v) for k, v in d.items() if k != \"value\"}\n    else:\n        node[\"properties\"].pop(key, None)\n        node[\"descriptors\"][key] = copy.deepcopy(d)\n\n\ndef _remove(node, key):\n    node[\"properties\"].pop(key, None)\n    node.get(\"descriptors\", {}).pop(key, None)\n    if \"keyOrder\" in node:\n        node[\"keyOrder\"] = [item for item in node[\"keyOrder\"] if item != key]\n\n\ndef _array_index(key):\n    \"\"\"Return an array index for a canonical array-index string, else None.\"\"\"\n    if (\n        not isinstance(key, str)\n        or len(key) > 10\n        or not key.isascii()\n        or not key.isdecimal()\n        or key.startswith(\"0\")\n        and key != \"0\"\n    ):\n        return None\n    index = int(key)\n    return index if index < 4294967295 else None\n\n\ndef _array_length(value):\n    # ArraySetLength applies ToNumber/ToUint32 before comparing the values.\n    # Abrupt conversions need an explicit throw record, not a false success flag.\n    try:\n        number = primitives._to_number(value)\n    except TypeError:\n        _fail(\"array length coercion requires an explicit abrupt boundary\")\n    if not math.isfinite(number) or not 0 <= number <= 4294967295 or int(number) != number:\n        _fail(\"invalid array length\")\n    return int(number)\n\n\ndef _set_array_length(node, new_length, writable=None):\n    \"\"\"Apply array length shrink/growth, including partial failure at a fixed index.\"\"\"\n    old = _descriptor(node, \"length\")\n    current = old[\"value\"][1]\n    success = True\n    if new_length < current:\n        blockers = sorted(\n            (\n                i\n                for key in set(node[\"properties\"]) | set(node.get(\"descriptors\", {}))\n                if (i := _array_index(key)) is not None and i >= new_length\n            ),\n            reverse=True,\n        )\n        for index in blockers:\n            key = str(index)\n            descriptor = _descriptor(node, key)\n            if descriptor is None:\n                continue\n            if not descriptor[\"configurable\"]:\n                new_length = index + 1\n                success = False\n                break\n            _remove(node, key)\n    # Explicit length writes use the same descriptor installer as the\n    # producer, including an unchanged value. Storage order is part of the\n    # serialized continuation; the installer preserves the separate keyOrder.\n    _install(\n        node,\n        \"length\",\n        {\n            **old,\n            \"value\": [\"num\", new_length],\n            \"writable\": old[\"writable\"] if writable is None else writable,\n        },\n    )\n    return success\n\n\ndef _ordered(node):\n    keys = []\n    descriptors = node.get(\"descriptors\", {})\n    for key in [*node.get(\"keyOrder\", []), *node[\"properties\"], *descriptors]:\n        if key not in keys and (key in node[\"properties\"] or key in descriptors):\n            keys.append(key)\n    return (\n        sorted((key for key in keys if _array_index(key) is not None), key=int)\n        + [key for key in keys if isinstance(key, str) and _array_index(key) is None]\n        + [key for key in keys if isinstance(key, tuple)]\n    )\n\n\ndef _compatible(node, key, d):\n    old = _descriptor(node, key)\n    if old is None:\n        return node.get(\"extensible\", True)\n    if old[\"configurable\"]:\n        return True\n    if d[\"configurable\"] or d[\"enumerable\"] != old[\"enumerable\"] or d[\"kind\"] != old[\"kind\"]:\n        return False\n    if old[\"kind\"] == \"accessor\":\n        return old[\"get\"] == d[\"get\"] and old[\"set\"] == d[\"set\"]\n    return old[\"writable\"] or not d[\"writable\"] and old[\"value\"] == d[\"value\"]\n\n\ndef _define_own_property(node, key, descriptor):\n    \"\"\"Apply the same descriptor/array rules to definitions and receiver writes.\"\"\"\n    index = None\n    if node[\"kind\"] == \"array\":\n        length = _descriptor(node, \"length\")\n        if key == \"length\":\n            if descriptor[\"kind\"] != \"data\":\n                return False\n            new_length = _array_length(descriptor[\"value\"])\n            descriptor = {**descriptor, \"value\": [\"num\", new_length]}\n            if not _compatible(node, key, descriptor):\n                return False\n            return _set_array_length(node, new_length, descriptor[\"writable\"])\n        index = _array_index(key)\n        if index is not None and index >= length[\"value\"][1] and not length[\"writable\"]:\n            return False\n    if not _compatible(node, key, descriptor):\n        return False\n    _install(node, key, descriptor)\n    if index is not None and index >= length[\"value\"][1]:\n        node[\"properties\"][\"length\"] = [\"num\", index + 1]\n    return True\n\n\ndef _local(machine, name):\n    cell = machine.get(\"captureAliases\", {}).get(name, name)\n    if cell not in machine[\"locals\"]:\n        _fail(\"unknown protocol local\")\n    return machine[\"locals\"][cell]\n\n\ndef _eval(machine, expr):\n    if expr[\"op\"] == \"literal\":\n        return _known(machine, expr[\"value\"])\n    if expr[\"op\"] == \"local\":\n        return _known(machine, _local(machine, expr[\"name\"]))\n    op = expr[\"op\"]\n    if op == \"logical-test\":\n        left = _eval(machine, expr[\"arg\"])\n        truthy = left[0] == \"symbol\" or primitives._truthy(left)\n        skip_right = (\n            not truthy\n            if expr[\"operator\"] == \"&&\"\n            else truthy\n            if expr[\"operator\"] == \"||\"\n            else left[0] not in (\"null\", \"undefined\")\n        )\n        return [\"bool\", skip_right]\n    if op == \"unary\":\n        a = _eval(machine, expr[\"arg\"])\n        if a[0] in (\"ref\", \"symbol\"):\n            if expr[\"operator\"] == \"!\":\n                return [\"bool\", False]\n            if expr[\"operator\"] == \"void\":\n                return [\"undefined\"]\n            if expr[\"operator\"] == \"typeof\":\n                return [\n                    \"str\",\n                    \"symbol\"\n                    if a[0] == \"symbol\"\n                    else (\n                        \"function\"\n                        if machine[\"heap\"].get(a[1], {}).get(\"kind\") == \"closure\"\n                        else \"object\"\n                    ),\n                ]\n            _fail(\"behavioral value coercion needs an abrupt boundary\")\n        opmap = {\n            \"!\": \"not\",\n            \"+\": \"positive\",\n            \"-\": \"negate\",\n            \"~\": \"bit_not\",\n            \"typeof\": \"type_of\",\n            \"void\": \"void\",\n        }\n        return _normalize_number(primitives._operation(opmap[expr[\"operator\"]], [a]))\n    left = _eval(machine, expr[\"left\"])\n    right = _eval(machine, expr[\"right\"])\n    operator = expr[\"operator\"]\n    if \"symbol\" in (left[0], right[0]):\n        if (\n            operator not in (\"===\", \"!==\", \"==\", \"!=\")\n            or \"ref\" in (left[0], right[0])\n            and operator in (\"==\", \"!=\")\n        ):\n            _fail(\"Symbol conversion needs an abrupt boundary\")\n        same = left[0] == right[0] == \"symbol\" and left[1] == right[1]\n        return [\"bool\", same if operator in (\"===\", \"==\") else not same]\n    opmap = {\n        \"+\": \"add\",\n        \"-\": \"subtract\",\n        \"*\": \"multiply\",\n        \"/\": \"divide\",\n        \"%\": \"remainder\",\n        \"**\": \"power\",\n        \"===\": \"equal\",\n        \"!==\": \"not_equal\",\n        \"==\": \"loose_equal\",\n        \"!=\": \"loose_not_equal\",\n        \"<\": \"less\",\n        \"<=\": \"less_equal\",\n        \">\": \"greater\",\n        \">=\": \"greater_equal\",\n        \"&\": \"bit_and\",\n        \"|\": \"bit_or\",\n        \"^\": \"bit_xor\",\n        \"<<\": \"shift_left\",\n        \">>\": \"shift_right\",\n        \">>>\": \"unsigned_shift_right\",\n    }\n    return _normalize_number(primitives._operation(opmap[operator], [left, right]))\n\n\ndef _normalize_number(value):\n    if (\n        isinstance(value, list)\n        and len(value) == 2\n        and value[0] == \"num\"\n        and type(value[1]) is float\n        and value[1].is_integer()\n    ):\n        value[1] = int(value[1])\n    return value\n\n\ndef _apply(machine, record):\n    p = machine[\"protocol\"]\n    pending = p[\"pendingCalls\"][-1] if p[\"pendingCalls\"] else None\n    if pending and pending[\"child\"] not in machine[\"s