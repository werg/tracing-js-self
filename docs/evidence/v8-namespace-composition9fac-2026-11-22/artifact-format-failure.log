2026-11-22T08:20:32.0611648Z FORMATTED_SOURCE_JSON {"path": "tests/integration/test_module_namespace_artifact_packing.py", "content": "\"\"\"Actual source-qualified namespace artifact through native V8 preparation and packing.\n\nThis isolated technical fixture uses its own one-member registry. It is not\nmerged into the immutable production corpus population and makes no learning\nclaim.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom megatoken.data import PreparedDataset, WindowConfig, iter_windows\nfrom megatoken.data.protocol_v8 import ProtocolV8Error, decode_protocol_record\nfrom megatoken.data.semantic_json import stable_algorithm_hash\nfrom megatoken.generation.codec import LING_TOKENIZER_SHA256, ByteCodec\n\n\ndef _run_checked(command, *, cwd: Path, timeout: int) -> subprocess.CompletedProcess[str]:\n    result = subprocess.run(\n        command, cwd=cwd, check=False, timeout=timeout, capture_output=True, text=True\n    )\n    if result.returncode:\n        raise AssertionError(\n            f\"Command failed ({result.returncode}): {command!r}\\n\"\n            f\"stdout:\\n{result.stdout[-4000:]}\\nstderr:\\n{result.stderr[-4000:]}\"\n        )\n    return result\n\n\ndef _revision(root: Path) -> str:\n    return subprocess.check_output([\"git\", \"rev-parse\", \"HEAD\"], cwd=root, text=True).strip()\n\n\ndef test_actual_namespace_artifact_is_source_rechecked_and_packed(tmp_path):\n    producer = Path(os.environ[\"TRACING_JS_SELF_ROOT\"]).resolve()\n    consumer = Path(os.environ[\"MEGATOKEN_ROOT\"]).resolve()\n    tokenizer = Path(os.environ[\"MEGATOKEN_TOKENIZER_JSON\"]).resolve()\n    artifact_path = tmp_path / \"namespace-source-artifact.json\"\n    prepared_path = tmp_path / \"prepared-namespace-v8\"\n\n    emitter = producer / \"tools/emit-semantic-v8-namespace-artifact.mjs\"\n    _run_checked(\n        [\"node\", str(emitter), \"--output\", str(artifact_path)],\n        cwd=producer,\n        timeout=180,\n    )\n    assert artifact_path.is_file()\n    artifact = json.loads(artifact_path.read_text())\n    program = next(row for row in artifact[\"public\"][\"timeline\"] if row[\"kind\"] == \"program\")\n    plan = program[\"fields\"][\"regionProgram\"][\"moduleNamespacePlan\"]\n    assert plan[\"schema\"] == \"semantic-module-namespace-plan/1\"\n    identity = artifact[\"sidecar\"][\"splitIdentity\"]\n    registry = identity[\"registry\"]\n    assert registry[\"digest\"] == artifact[\"sidecar\"][\"familyRegistryDigest\"]\n    assert len(registry[\"sources\"]) == 1\n    assert registry[\"sources\"][0][\"id\"] == identity[\"sourceId\"]\n\n    script = consumer / \"scripts/prepare_semantic_v8.py\"\n    _run_checked(\n        [\n            sys.executable,\n            str(script),\n            \"--input\",\n            str(artifact_path),\n            \"--output\",\n            str(prepared_path),\n            \"--producer-root\",\n            str(producer),\n            \"--producer-revision\",\n            _revision(producer),\n            \"--consumer-revision\",\n            _revision(consumer),\n            \"--tokenizer-json\",\n            str(tokenizer),\n            \"--max-positions\",\n            \"8192\",\n            \"--max-history\",\n            \"1024\",\n        ],\n        cwd=consumer,\n        timeout=300,\n    )\n\n    report_path = prepared_path / \"semantic-v8-report.json\"\n    report_bytes = report_path.read_bytes()\n    report_text = report_bytes.decode(\"utf-8\")\n    report = json.loads(report_text)\n    assert report[\"counts\"][\"attempted\"] == 1\n    assert report[\"counts\"][\"admitted\"] == 1\n    assert report[\"counts\"].get(\"refused\", 0) == 0\n    assert report[\"optimizerSteps\"] == 0\n    assert report[\"learningClaim\"] is None\n\n    with PreparedDataset(prepared_path, split=None) as prepared:\n        assert len(prepared) == 1\n        episode = prepared[0]\n    assert episode.records\n    assert any(record.policy_mask and record.role == \"assistant\" for record in episode.records)\n    semantic = json.loads(episode.supervision.annotations_json)[\"semantic_execution\"]\n    assert semantic[\"admission\"] == \"admitted\"\n    assert semantic[\"modelExecutionOutcome\"] == \"unmeasured\"\n    assert semantic[\"sourceAdmission\"][\"sourceValidated\"] is True\n    assert semantic[\"sourceAdmission\"][\"projectionValidated\"] is True\n    assert semantic[\"nativeAdmission\"][\"checks\"][\"sourceBinding\"] == \"passed\"\n    assert semantic[\"nativeAdmission\"][\"checks\"][\"tokenizer\"] == \"passed\"\n    assert semantic[\"nativeAdmission\"][\"tokenizer\"][\"sha256\"] == LING_TOKENIZER_SHA256\n    assert semantic[\"nativeAdmission\"][\"counts\"][\"protocolRecords\"] > 0\n    assert semantic[\"nativeTrainingDigest\"]\n    assert semantic[\"tokenizerEvidence\"][\"sha256\"] == LING_TOKENIZER_SHA256\n\n    manifest_path = prepared_path / \"manifest.json\"\n    manifest_bytes = manifest_path.read_bytes()\n    manifest_text = manifest_bytes.decode(\"utf-8\")\n    manifest = json.loads(manifest_text)\n    codec = ByteCodec.from_tokenizer_json(tokenizer, expected_sha256=LING_TOKENIZER_SHA256)\n    required_kinds = {\n        \"namespace.create\",\n        \"cell.initialize\",\n        \"cell.write\",\n        \"namespace.keys\",\n        \"namespace.read\",\n        \"namespace.descriptor\",\n    }\n    packed_targets = {kind: [] for kind in required_kinds}\n    windows = tuple(\n        iter_windows(episode, codec, WindowConfig(max_window_tokens=8192, max_decisions=4))\n    )\n    for window in windows:\n        for encoded in window.records:\n            record = encoded.record\n            if record.role != \"assistant\" or not record.policy_mask:\n                continue\n            try:\n                protocol_record = decode_protocol_record(record.payload.decode(\"utf-8\"))\n            except ProtocolV8Error:\n                continue\n            if protocol_record[\"kind\"] not in required_kinds:\n                continue\n            assert encoded.token_ids\n            assert len(encoded.token_ids) == len(encoded.free_mask)\n            assert encoded.P > 0\n            packed_targets[protocol_record[\"kind\"]].append(encoded)\n    assert all(packed_targets[kind] for kind in required_kinds)\n\n    packed_target_evidence = {}\n    for kind, encoded_rows in sorted(packed_targets.items()):\n        encoded_identity = [\n            {\n                \"recordId\": row.record.record_id,\n                \"tokenIds\": list(row.token_ids),\n                \"freeMask\": list(row.free_mask),\n            }\n            for row in encoded_rows\n        ]\n        packed_target_evidence[kind] = {\n            \"targetRecords\": len(encoded_rows),\n            \"tokenIds\": sum(len(row.token_ids) for row in encoded_rows),\n            \"scoredPositions\": sum(row.P for row in encoded_rows),\n            \"tokenAndMaskDigest\": hashlib.sha256(\n                json.dumps(encoded_identity, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n            ).hexdigest(),\n        }\n\n    source_identity = artifact[\"sidecar\"][\"splitIdentity\"]\n    binding = artifact[\"sidecar\"][\"datasetBinding\"]\n    evidence = {\n        \"schema\": \"semantic-v8-namespace-artifact-pack-evidence/1\",\n        \"sourceArtifactSha256\": hashlib.sha256(artifact_path.read_bytes()).hexdigest(),\n        \"sourceFamily\": source_identity[\"family\"],\n        \"sourceId\": source_identity[\"sourceId\"],\n        \"sourceDigest\": source_identity[\"sourceDigest\"],\n        \"sourceComponentId\": source_identity[\"componentId\"],\n        \"split\": source_identity[\"split\"],\n        \"registryDigest\": source_identity[\"registryDigest\"],\n        \"datasetBinding\": binding,\n        \"datasetBindingDigest\": stable_algorithm_hash(binding),\n        \"publicDigest\": binding[\"episodeDigest\"],\n        \"contextsDigest\": binding[\"contextsDigest\"],\n        \"sourceArtifactDigest\": binding[\"sourceArtifactDigest\"],\n        \"sourceAdmission\": semantic[\"sourceAdmission\"],\n        \"nativeAdmission\": semantic[\"nativeAdmission\"],\n        \"tokenizerEvidence\": semantic[\"tokenizerEvidence\"],\n        \"preparedSemanticV8ReportRaw\": report_text,\n        \"preparedSemanticV8ReportSha256\": hashlib.sha256(report_bytes).hexdigest(),\n        \"preparedSemanticV8Report\": report,\n        \"preparedManifestRaw\": manifest_text,\n        \"preparedManifestSha256\": hashlib.sha256(manifest_bytes).hexdigest(),\n        \"preparedManifestFingerprint\": manifest[\"fingerprint\"],\n        \"preparedCodecFingerprint\": manifest[\"codec_fingerprint\"],\n        \"producerRevision\": semantic[\"sourceAdmission\"][\"producerRevision\"],\n        \"consumerRevision\": semantic[\"nativeAdmission\"][\"consumerRevision\"],\n        \"preparedManifest\": manifest,\n        \"packedWindowCount\": len(windows),\n        \"packedTargetsByKind\": packed_target_evidence,\n        \"optimizerSteps\": 0,\n        \"learnedSuccess\": None,\n    }\n    print(\n        \"NAMESPACE_ARTIFACT_PACK_EVIDENCE_JSON \"\n        + json.dumps(evidence, sort_keys=True, separators=(\",\", \":\"))\n    )\n"}
