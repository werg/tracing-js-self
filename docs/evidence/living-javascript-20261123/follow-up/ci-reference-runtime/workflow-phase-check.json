{
  "matrix": {
    "node-version": [
      "20",
      "22",
      "24"
    ]
  },
  "referenceVersionFile": ".nvmrc",
  "referenceRuntime": "v24.22.3",
  "everyExistingRunCommandPreserved": true,
  "noSkippedOrAllowedFailureSteps": true,
  "phases": [
    {
      "command": "npm ci",
      "runtime": "matrix"
    },
    {
      "command": "npm test",
      "runtime": "matrix"
    },
    {
      "command": "npm run semantic:contract",
      "runtime": "matrix"
    },
    {
      "command": "npm run semantic:v8:contract",
      "runtime": "reference"
    },
    {
      "command": "node tools/inspect-semantic-reasoning.mjs",
      "runtime": "reference"
    },
    {
      "command": "node bin/tracing.js demo --output \"${RUNNER_TEMP}/demo.trace.json\"",
      "runtime": "matrix"
    },
    {
      "command": "node bin/tracing.js replay \"${RUNNER_TEMP}/demo.trace.json\"",
      "runtime": "matrix"
    }
  ]
}
