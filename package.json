{
  "name": "tracing-js-self",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./runtime": "./src/runtime.js",
    "./validation": "./src/validation.js",
    "./replay": "./src/replay.js",
    "./causal": "./src/causal.js",
    "./native": "./src/host/native-driver.js",
    "./capabilities/graph": "./src/host/graph-codec.js",
    "./training/tinker": "./src/training/tinker-execution.js",
    "./training/tinker-import": "./src/training/tinker-import.js"
  },
  "description": "Owned-machine JavaScript execution tracer and Inkling/Tinker training harness",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --test test/*.test.js && node fixtures/reference/reference-fixture.mjs",
    "demo": "node bin/tracing.js demo",
    "trace": "node bin/tracing.js run",
    "tinker": "python3 training/run.py",
    "test:tinker": "node --experimental-vm-modules --test test/tinker-*.test.js && python3 training/run_tests.py",
    "tinker:export": "python3 training/run.py --config training/configs/inkling-mini.json export",
    "tinker:check": "python3 training/run.py --config training/configs/inkling-mini.json check",
    "tinker:build": "node tools/tinker-benchmark.mjs build --output-dir training/fixtures/expanded",
    "tinker:census": "node tools/tinker-benchmark.mjs census --output-dir runs/tinker-census",
    "tinker:fuzz": "node tools/tinker-benchmark.mjs fuzz --output-dir runs/tinker-fuzz",
    "tinker:audit": "node tools/tinker-supervision.mjs --dataset training/fixtures/expanded/main.jsonl --output runs/tinker-supervision/audit.json --include-messages",
    "tinker:study": "python3 training/experiment.py",
    "tinker:probe": "python3 training/experiment.py probe --output-dir runs/tinker-probe"
  },
  "bin": {
    "tracing-js-self": "./bin/tracing.js"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "typescript": "5.9.3"
  },
  "imports": {
    "#owned-proxy-check": {
      "browser": "./src/host/proxy-check-browser.js",
      "default": "./src/host/proxy-check-node.js"
    }
  }
}
