{
  "name": "tracing-js-self",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "browser": "./src/browser.js",
      "default": "./src/index.js"
    },
    "./runtime": "./src/runtime.js",
    "./validation": "./src/validation.js",
    "./replay": "./src/replay.js",
    "./causal": "./src/causal.js",
    "./training": "./src/training/index.js",
    "./natlang-selected": {
      "types": "./src/natlang-selected.d.ts",
      "default": "./src/natlang-selected.js"
    },
    "./natlang": {
      "types": "./src/natlang.d.ts",
      "default": "./src/natlang.js"
    },
    "./modules": {
      "types": "./src/modules.d.ts",
      "default": "./src/modules.js"
    },
    "./evaluated-modules": {
      "types": "./src/evaluated-modules.d.ts",
      "default": "./src/evaluated-modules.js"
    },
    "./evaluated-module-session": {
      "types": "./src/evaluated-module-session.d.ts",
      "default": "./src/evaluated-module-session.js"
    },
    "./evaluated-module-facade": {
      "types": "./src/evaluated-module-facade.d.ts",
      "default": "./src/evaluated-module-facade.js"
    },
    "./native": {
      "types": "./src/host/native-driver.d.ts",
      "default": "./src/host/native-driver.js"
    },
    "./storage/node": {
      "types": "./src/storage/node.d.ts",
      "default": "./src/storage/node.js"
    },
    "./agent-model": "./src/agent-model.js",
    "./native-worker-agents": "./src/native-worker-agents.js",
    "./browser": {
      "types": "./src/browser.d.ts",
      "default": "./src/browser.js"
    },
    "./training/diagnostic": "./src/training/diagnostic.js",
    "./capabilities/node": "./src/host/selected-capabilities-node.js",
    "./capabilities/browser": "./src/host/selected-capabilities-browser.js",
    "./capabilities/graph": "./src/host/graph-codec.js"
  },
  "description": "Experimental owned-machine JavaScript semantic tracing runtime",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js && node fixtures/reference/reference-fixture.mjs",
    "audit:engine": "node scripts/audit-engine262.mjs",
    "test:arithmetic": "node scripts/run-owned-arithmetic-probes.mjs",
    "test:test262-runtime": "node scripts/run-runtime-conformance.mjs --oracle",
    "demo": "node bin/tracing.js demo",
    "trace": "node bin/tracing.js run",
    "test:selected-test262": "node tools/test262-baseline.mjs",
    "corpus:generate": "node tools/build-real-corpus.mjs",
    "corpus:audit": "node tools/audit-real-corpus.mjs",
    "corpus:owned-coverage": "node tools/audit-owned-coverage.mjs",
    "corpus:owned-merge": "node tools/merge-owned-coverage.mjs",
    "corpus:stateful:audit": "node tools/audit-stateful-corpus.mjs",
    "corpus:stateful": "node tools/build-stateful-corpus.mjs",
    "corpus:external": "node tools/import-external-corpus.mjs",
    "corpus:stateful:differential": "node tools/verify-stateful-differential.mjs",
    "corpus:adversarial": "node tools/build-stateful-corpus.mjs --suite adversarial",
    "corpus:adversarial:audit": "node tools/audit-stateful-corpus.mjs --suite adversarial",
    "corpus:exercism:owned": "node tools/verify-exercism-owned.mjs",
    "corpus:full:disposition": "node tools/convert-full-corpus.mjs",
    "corpus:test262:scalar": "node tools/verify-test262-scalar.mjs",
    "corpus:test262:reference": "node tools/verify-test262-reference.mjs",
    "corpus:test262:reference:modules": "node --experimental-vm-modules tools/verify-test262-reference.mjs",
    "corpus:structured:reference": "node tools/verify-structured-contracts.mjs",
    "corpus:owned:novelty": "node tools/select-owned-episodes.mjs",
    "corpus:production:owned": "node tools/verify-production-owned.mjs",
    "corpus:ajv:reference": "node tools/verify-ajv-snapshot.mjs",
    "diagnostic:generate": "node tools/generate-diagnostic-training.mjs",
    "diagnostic:evaluate": "node tools/evaluate-training.mjs",
    "diagnostic:inspect": "node tools/inspect-training.mjs",
    "diagnostic:recheck": "node tools/recheck-training-evidence.mjs",
    "diagnostic:experiment": "node tools/evaluate-training-experiments.mjs",
    "diagnostic:freeze": "node tools/freeze-training-test.mjs",
    "training:generate": "node tools/generate-effectful-training.mjs",
    "training:evaluate": "node tools/run-selected-evaluation.mjs",
    "training:freeze": "node tools/freeze-selected-evaluation.mjs",
    "training:recheck": "node tools/verify-effectful-admission.mjs",
    "training:inspect": "node tools/inspect-selected-harness.mjs",
    "training:session-campaign": "node tools/semantic-session-campaign.mjs",
    "contracts:check": "node tools/generate-host-contract.mjs --check && node tools/generate-semantic-contract.mjs --check",
    "test:browser": "node --test test/browser/selected-dom.test.mjs"
  },
  "bin": {
    "tracing-js-self": "./bin/tracing.js"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "typescript": "5.9.3"
  },
  "imports": {
    "#owned-proxy-check": {
      "browser": "./src/host/proxy-check-browser.js",
      "default": "./src/host/proxy-check-node.js"
    }
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
